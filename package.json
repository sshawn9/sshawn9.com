{
  "name": "sshawn9.com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --kill-others-on-fail --names site,worker --prefix-colors cyan,magenta \"npm:dev:site\" \"npm:dev:worker\"",
    "dev:site": "npm run dev --workspace @sshawn9/site-v2",
    "dev:worker": "wrangler dev --assets public --ip 127.0.0.1 --port 8787 --local --show-interactive-dev-session=false",
    "check": "npm run check --workspaces --if-present && tsc --noEmit --project tsconfig.json",
    "build": "npm run build --workspace @sshawn9/site-v2",
    "build:preview": "SITE_MODE=preview npm run build",
    "preview": "npm run build:preview && wrangler dev --assets apps/site-v2/dist",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e --workspace @sshawn9/site-v2",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@sshawn9/site-domain": "0.0.0"
  },
  "devDependencies": {
    "@sshawn9/content-ui": "0.0.0",
    "@sshawn9/site-i18n": "0.0.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vega": "^6.3.1",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
