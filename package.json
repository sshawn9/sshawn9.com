{
  "name": "sshawn9.com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "check:v2": "npm run check --workspace @sshawn9/site-v2",
    "build": "astro build && pagefind --site dist",
    "build:v2": "npm run build --workspace @sshawn9/site-v2",
    "test:e2e:v2": "npm run test:e2e --workspace @sshawn9/site-v2",
    "preview": "astro preview",
    "preview:worker": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@sshawn9/content-ui": "0.0.0",
    "@sshawn9/site-build": "0.0.0",
    "@sshawn9/site-domain": "0.0.0",
    "@sshawn9/site-i18n": "0.0.0",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/solid-js": "^7.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@kobalte/core": "^0.13.12",
    "@lucide/astro": "^1.24.0",
    "@oddbird/popover-polyfill": "^0.7.1",
    "@swup/a11y-plugin": "^5.2.1",
    "@swup/head-plugin": "^2.3.1",
    "@swup/preload-plugin": "^3.2.11",
    "@swup/scripts-plugin": "^2.1.0",
    "astro": "^7.1.6",
    "astro-expressive-code": "^0.44.0",
    "astro-seo": "^1.1.0",
    "astro-seo-schema": "^7.0.0",
    "diff": "^8.0.4",
    "diff2html": "^3.4.56",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.47",
    "lucide-solid": "^1.28.0",
    "motion": "^12.42.2",
    "nanostores": "^1.5.0",
    "photoswipe": "^5.4.4",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "schema-dts": "^1.1.5",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.14",
    "swup": "^4.9.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
