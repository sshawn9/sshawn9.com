---
import { listArticles, tags } from '@poc-shared/fixture-data';
import InitialFrameCoordinator from './InitialFrameCoordinator.astro';

interface Props {
  activeTag?: string;
}

const { activeTag } = Astro.props;
const articles = activeTag
  ? listArticles.filter((entry) => entry.tags.some((tag) => tag === activeTag))
  : listArticles;
const repeatedArticles = Array.from({ length: 3 }, () => articles).flat();
const initialFrameArticleIndex = Math.min(2, repeatedArticles.length - 1);
---

<div class="blog-layout" data-blog-page>
  <aside class="tag-rail" data-scroll-region="tag-rail" aria-labelledby="tag-heading">
    <h1 id="tag-heading">文章标签</h1>
    <ul class="tag-list">
      {
        tags.map(([tag, count]) => (
          <li>
            <a
              class="tag-link"
              href={tag === 'Frenet' ? '/zh/blog/tag/frenet/' : '/zh/blog/'}
              aria-current={activeTag === tag ? 'page' : undefined}
            >
              <span>{tag}</span>
              <small>{count}</small>
            </a>
          </li>
        ))
      }
    </ul>
  </aside>

  <section aria-labelledby="articles-heading">
    <h1 id="articles-heading">{activeTag ? '#' + activeTag : '全部文章'}</h1>
    <p>共 {repeatedArticles.length} 篇</p>
    {
      repeatedArticles.length === 0 && (
        <span id="initial-frame-ready">
          <InitialFrameCoordinator />
        </span>
      )
    }
    <ol class="article-list">
      {
        repeatedArticles.map((entry, index) => (
          <li
            class="article-card"
            id={index === initialFrameArticleIndex ? 'initial-frame-ready' : undefined}
          >
            <div>
              <h2>
                <a
                  href={'/zh/blog/frenet-poc/?source=' + entry.slug + '-' + index}
                  data-article-link={index === 0 ? 'primary' : index === 1 ? 'history' : undefined}
                >
                  {entry.title}
                </a>
              </h2>
              <p>{entry.description}</p>
            </div>
            <div>
              <div class="article-meta">{entry.publishedAt}</div>
              <div class="tag-row">
                {entry.tags.map((tag) => (
                  <span class="tag-pill">#{tag}</span>
                ))}
              </div>
            </div>
            {index === initialFrameArticleIndex && <InitialFrameCoordinator />}
          </li>
        ))
      }
    </ol>
  </section>
</div>
