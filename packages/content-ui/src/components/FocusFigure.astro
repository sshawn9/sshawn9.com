---
import { Maximize2, Minimize2 } from '@lucide/astro';
import { BASE_LOCALE, requireLocale, toLanguageTag } from '@sshawn9/site-domain/locales';
import * as m from '@sshawn9/site-i18n/messages';

type Props = {
  number: number;
  dimensions?: 1 | 2;
  variant?: 'frenet' | 'research';
};

const { number, dimensions = 1, variant = 'frenet' } = Astro.props;
const locale = requireLocale(Astro.currentLocale ?? BASE_LOCALE);
const languageTag = toLanguageTag(locale);
const expandLabel = m.figure_expand({ number }, { locale });
const collapseLabel = m.figure_collapse({ number }, { locale });
const fallbackLabel = m.interactive_figure_javascript_required({}, { locale });
const loadingLabel = m.interactive_figure_loading({}, { locale });
const errorLabel = m.interactive_figure_unavailable({}, { locale });
---

<figure
  class:list={[
    'not-prose',
    variant === 'research' ? 'research-article-figure' : 'frenet-article-figure',
  ]}
  data-figure-focus
  data-dimensions={dimensions === 2 ? '2' : undefined}
>
  <slot />
  <interactive-figure-status
    data-state="fallback"
    data-loading-label={loadingLabel}
    data-error-label={errorLabel}
  >
    <p data-interactive-figure-status-message role="status" aria-live="polite">
      {fallbackLabel}
    </p>
  </interactive-figure-status>
  <button
    type="button"
    lang={languageTag}
    class="frenet-focus-toggle"
    data-figure-focus-toggle
    data-expand-label={expandLabel}
    data-collapse-label={collapseLabel}
    aria-label={expandLabel}
    aria-controls="figure-focus-dialog"
    aria-pressed="false"
    title={expandLabel}
  >
    <Maximize2 class="frenet-focus-expand-icon" aria-hidden="true" />
    <Minimize2 class="frenet-focus-collapse-icon" aria-hidden="true" />
  </button>
  <slot name="caption" />
</figure>
