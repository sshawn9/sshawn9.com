---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import RestoreScrollPosition from '../components/RestoreScrollPosition.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { BASE_LOCALE, toLanguageTag, type Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  searchable?: boolean;
  locale?: Locale;
  alternateLocales?: Locale[];
};

const {
  locale = BASE_LOCALE,
  title = m.site_title({}, { locale }),
  description,
  canonical,
  image,
  type = 'website',
  noIndex = false,
  searchable = true,
  alternateLocales,
} = Astro.props;
const lang = toLanguageTag(locale);
---

<!doctype html>
<html lang={lang} data-locale={locale}>
  <head>
    <BaseHead
      {title}
      {description}
      {canonical}
      {image}
      {type}
      {noIndex}
      {locale}
      {alternateLocales}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader {locale} />
    <div id="swup" class="swup-transition-main relative z-10 flex min-h-0 flex-1 flex-col">
      <main
        id="main-content"
        class="flex-1"
        data-pagefind-body={searchable ? '' : undefined}
        data-pagefind-ignore={searchable ? undefined : 'all'}
      >
        <slot />
      </main>
      <SiteFooter {locale} />
    </div>
    <RestoreScrollPosition />
    <script>
      import { startNavigationController } from '../scripts/navigation-controller';
      import { startPageRouter } from '../scripts/page-router';
      import '../scripts/reveal';
      import '../scripts/transient-ui';
      import { startTypographyController } from '../scripts/typography-controller';

      startPageRouter();
      void startTypographyController();
      startNavigationController();
    </script>
  </body>
</html>
