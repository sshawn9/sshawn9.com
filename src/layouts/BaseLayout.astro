---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import WallpaperBackground from '../components/WallpaperBackground.astro';
import { BASE_LOCALE, toLanguageTag, type Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  searchable?: boolean;
  locale?: Locale;
  alternateLocales?: Locale[];
};

const {
  locale = BASE_LOCALE,
  title = m.site_title({}, { locale }),
  description,
  canonical,
  image,
  type = 'website',
  noIndex = false,
  searchable = true,
  alternateLocales,
} = Astro.props;
const lang = toLanguageTag(locale);
---

<!doctype html>
<html lang={lang} data-locale={locale}>
  <head>
    <BaseHead
      {title}
      {description}
      {canonical}
      {image}
      {type}
      {noIndex}
      {locale}
      {alternateLocales}
    />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <WallpaperBackground {locale} />
    <a
      class="fixed top-3 left-3 z-[100] -translate-y-20 rounded-full bg-slate-950 px-4 py-2 text-sm font-bold text-white transition focus:translate-y-0 dark:bg-white dark:text-slate-950"
      href="#main-content"
    >
      {m.skip_to_content({}, { locale })}
    </a>
    <SiteHeader {locale} />
    <span
      class="sr-only"
      role="status"
      aria-atomic="true"
      data-navigation-status
      data-loading-label={m.navigation_loading({}, { locale })}
      data-pagefind-ignore></span>
    <main
      id="main-content"
      class="relative z-10 flex-1"
      data-pagefind-body={searchable ? '' : undefined}
      data-pagefind-ignore={searchable ? undefined : 'all'}
    >
      <slot />
    </main>
    <SiteFooter {locale} />
    <script>
      import '../scripts/reveal';
      import '../scripts/navigation';
      import '../scripts/theme';
      import '../scripts/transient-ui';
      import '../scripts/wallpaper';
    </script>
  </body>
</html>
