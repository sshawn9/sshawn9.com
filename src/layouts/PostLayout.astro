---
import type { MarkdownHeading } from 'astro';
import { ArrowUp, ChevronDown } from '@lucide/astro';
import { Schema } from 'astro-seo-schema';
import type { BlogPosting, WithContext } from 'schema-dts';
import ArticleSidebarLayout from '../components/ArticleSidebarLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VersionSwitcher from '../components/VersionSwitcher.astro';
import { SITE } from '../config';
import { localePath, toLanguageTag } from '../i18n/config';
import { formatDate } from '../lib/date';
import { getArticleHref, getArticleVersionHref } from '../lib/article-routes';
import {
  getArticleTags,
  getArticleUpdatedAt,
  type Article,
  type ArticleVersion,
} from '../lib/articles';
import { getTagHref } from '../lib/tags';
import BaseLayout from './BaseLayout.astro';
import * as m from '@sshawn9/site-i18n/messages';

type Props = {
  article: Article;
  version: ArticleVersion;
  headings: MarkdownHeading[];
  currentRoute?: boolean;
};

const { article, version, headings, currentRoute = false } = Astro.props;
const post = version.entry;
const locale = article.locale;
const contentLanguageTag = toLanguageTag(version.contentLocale);
const canonicalPath = currentRoute
  ? getArticleHref(article, version.contentLocale)
  : getArticleVersionHref(article, version, version.contentLocale);
const canonical = post.data.canonical ?? new URL(canonicalPath, Astro.site ?? SITE.url).toString();
const firstPublished = article.versions[0].entry.data.publishedAt;
const updatedAt = getArticleUpdatedAt(version);
const articleSchema: WithContext<BlogPosting> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  ...(post.data.description ? { description: post.data.description } : {}),
  datePublished: firstPublished.toISOString(),
  dateModified: (updatedAt ?? firstPublished).toISOString(),
  inLanguage: contentLanguageTag,
  mainEntityOfPage: canonical,
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
};
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const tocGroups = toc.reduce<Array<{ heading: MarkdownHeading; children: MarkdownHeading[] }>>(
  (groups, heading) => {
    if (heading.depth === 2 || groups.length === 0) {
      groups.push({ heading, children: [] });
    } else {
      groups.at(-1)?.children.push(heading);
    }

    return groups;
  },
  [],
);
const pageTitle = currentRoute
  ? post.data.title
  : m.article_version_title({ title: post.data.title, version: version.number }, { locale });
const breadcrumbs = currentRoute
  ? [
      { label: m.nav_blog({}, { locale }), href: localePath(locale, '/blog/') },
      { label: post.data.title, lang: contentLanguageTag },
    ]
  : [
      { label: m.nav_blog({}, { locale }), href: localePath(locale, '/blog/') },
      { label: post.data.title, href: getArticleHref(article), lang: contentLanguageTag },
      { label: `v${version.number}` },
    ];
const fallbackLanguage =
  version.contentLocale === 'zh'
    ? m.article_fallback_language_zh({}, { locale })
    : m.article_fallback_language_en({}, { locale });
const requestedLanguage =
  locale === 'zh'
    ? m.article_fallback_language_zh({}, { locale })
    : m.article_fallback_language_en({}, { locale });
const articleTags = getArticleTags(article);
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  canonical={canonical}
  type="article"
  searchResultType="article"
  {locale}
  noIndex={!currentRoute || !version.hasRequestedLocale}
  searchable={currentRoute}
  alternateLocales={version.availableLocales}
>
  <Schema slot="head" item={articleSchema} />

  <article class="content-shell pt-12 sm:pt-16">
    <ArticleSidebarLayout {locale}>
      <Fragment slot="main">
        <header data-reveal>
          <Breadcrumbs items={breadcrumbs} {locale} />

          <h1
            lang={contentLanguageTag}
            class="mt-8 text-4xl font-extrabold tracking-[-0.045em] text-balance sm:text-5xl"
            data-pagefind-meta="title"
          >
            {post.data.title}
          </h1>
          {
            post.data.description && (
              <p
                lang={contentLanguageTag}
                class="text-default mt-5 max-w-4xl text-lg leading-8 sm:text-xl"
                data-pagefind-meta="description"
              >
                {post.data.description}
              </p>
            )
          }

          <div class="sr-only" aria-hidden="true" data-pagefind-ignore>
            <time
              data-pagefind-meta="published"
              data-pagefind-sort="published[datetime]"
              datetime={firstPublished.toISOString()}
            >
              {formatDate(firstPublished, locale)}
            </time>
          </div>

          {
            articleTags.length > 0 && (
              <div
                class="mt-5 flex flex-wrap items-center gap-2"
                aria-label={m.article_tags({}, { locale })}
              >
                {articleTags.map((tag) => (
                  <a
                    href={getTagHref(tag, locale)}
                    data-article-tag-link={tag}
                    class="tag-chip rounded-full px-3 py-1 font-mono text-[0.68rem]"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }

          {
            !version.hasRequestedLocale && (
              <p class="text-supporting mt-5 text-xs leading-5" data-pagefind-ignore>
                {m.article_fallback_notice(
                  { language: fallbackLanguage, requestedLanguage },
                  { locale },
                )}
              </p>
            )
          }

          <dl
            class="mt-7 grid grid-cols-2 gap-4 border-y border-slate-900/8 py-4 text-xs lg:hidden dark:border-white/8 print:grid"
            data-article-mobile-information
            data-pagefind-ignore
          >
            <div>
              <dt class="text-supporting">
                {m.article_first_published({}, { locale })}
              </dt>
              <dd class="mt-1 font-medium">
                <time datetime={firstPublished.toISOString()}
                  >{formatDate(firstPublished, locale)}</time
                >
              </dd>
            </div>
            {
              updatedAt && (
                <div>
                  <dt class="text-supporting">{m.article_last_updated({}, { locale })}</dt>
                  <dd class="mt-1 font-medium">
                    <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt, locale)}</time>
                  </dd>
                </div>
              )
            }
          </dl>

          {
            toc.length > 0 && (
              <div class="mt-7 lg:hidden print:hidden" data-pagefind-ignore>
                <button
                  type="button"
                  popovertarget="article-toc-mobile"
                  aria-expanded="false"
                  class="group flex w-full items-center justify-between gap-4 rounded-2xl border border-slate-900/10 bg-slate-900/[0.025] p-4 text-sm font-bold dark:border-white/10 dark:bg-white/[0.025]"
                >
                  {m.article_toc({}, { locale })}
                  <ChevronDown
                    class="size-4 transition-transform group-aria-expanded:rotate-180"
                    aria-hidden="true"
                  />
                </button>
                <div
                  id="article-toc-mobile"
                  popover
                  class="modal-popover surface-strong fixed top-1/2 left-1/2 m-0 max-h-[min(70dvh,32rem)] w-[min(28rem,calc(100%_-_2rem))] -translate-x-1/2 -translate-y-1/2 overflow-y-auto rounded-2xl p-5 shadow-2xl"
                  data-transient-overlay
                >
                  <h2 id="article-toc-mobile-heading" class="text-sm font-extrabold">
                    {m.article_toc({}, { locale })}
                  </h2>
                  <nav
                    lang={contentLanguageTag}
                    aria-labelledby="article-toc-mobile-heading"
                    class="mt-4 border-l border-slate-900/10 dark:border-white/10"
                    data-article-toc
                  >
                    {toc.map((heading, index) => (
                      <a
                        href={`#${heading.slug}`}
                        class:list={[
                          'toc-entry block border-l py-1.5 text-xs leading-5',
                          heading.depth === 3 ? 'pl-6' : 'pl-4 font-semibold',
                          index === 0 && 'is-active-link',
                        ]}
                        aria-current={index === 0 ? 'location' : undefined}
                      >
                        {heading.text}
                      </a>
                    ))}
                  </nav>
                </div>
              </div>
            )
          }

          {
            article.isVersioned && (
              <div class="mt-7 rounded-2xl border border-slate-900/10 bg-slate-900/[0.025] p-4 lg:hidden dark:border-white/10 dark:bg-white/[0.025] print:hidden">
                <VersionSwitcher {article} selected={version} variant="mobile" />
              </div>
            )
          }
        </header>

        <div
          lang={contentLanguageTag}
          class="article-prose js-toc-content prose prose-lg mt-10 max-w-none prose-headings:tracking-tight prose-headings:text-balance prose-blockquote:not-italic"
        >
          <slot />
        </div>

        <footer
          class="mt-16 flex justify-end border-t border-slate-900/10 pt-6 dark:border-white/10"
          data-pagefind-ignore
          data-article-footer
        >
          <a href="#main-content" class="interactive-supporting inline-flex items-center gap-2">
            {m.article_back_to_top({}, { locale })}
            <ArrowUp class="size-4" aria-hidden="true" />
          </a>
        </footer>
      </Fragment>

      <section aria-labelledby="article-info-heading">
        <h2 id="article-info-heading" class="sidebar-heading">
          {m.article_information({}, { locale })}
        </h2>
        <dl class="mt-4">
          <div class="flex items-baseline gap-3 py-1.5 text-xs leading-5">
            <dt class="text-supporting">
              {m.article_first_published({}, { locale })}
            </dt>
            <dd class="text-supporting ml-auto font-mono text-[0.62rem]">
              <time datetime={firstPublished.toISOString()}
                >{formatDate(firstPublished, locale)}</time
              >
            </dd>
          </div>
          {
            updatedAt && (
              <div class="flex items-baseline gap-3 py-1.5 text-xs leading-5">
                <dt class="text-supporting">{m.article_last_updated({}, { locale })}</dt>
                <dd class="text-supporting ml-auto font-mono text-[0.62rem]">
                  <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt, locale)}</time>
                </dd>
              </div>
            )
          }
        </dl>
      </section>

      {
        toc.length > 0 && (
          <section
            class="mt-7 border-t border-slate-900/10 pt-6 dark:border-white/10"
            aria-labelledby="article-toc-heading"
          >
            <h2 id="article-toc-heading" class="sidebar-heading">
              {m.article_toc({}, { locale })}
            </h2>
            <nav
              class="js-toc mt-4"
              lang={contentLanguageTag}
              aria-labelledby="article-toc-heading"
              data-article-toc
            >
              <ul class="toc-list">
                {tocGroups.map(({ heading, children }, index) => (
                  <li class="toc-list-item">
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        `toc-link node-name--H${heading.depth}`,
                        index === 0 && 'is-active-link',
                      ]}
                      aria-current={index === 0 ? 'location' : undefined}
                    >
                      {heading.text}
                    </a>
                    {children.length > 0 && (
                      <ul class="toc-list">
                        {children.map((child) => (
                          <li class="toc-list-item">
                            <a
                              href={`#${child.slug}`}
                              class={`toc-link node-name--H${child.depth}`}
                            >
                              {child.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </section>
        )
      }

      {
        article.isVersioned && (
          <div class="mt-7 border-t border-slate-900/10 pt-6 dark:border-white/10">
            <VersionSwitcher {article} selected={version} variant="desktop" />
          </div>
        )
      }
    </ArticleSidebarLayout>
  </article>

  <script is:inline>
    (() => {
      const section = window.__SSHawn9SiteBootstrap?.articleSection;
      if (!section || section.pathname !== location.pathname) return;

      document.querySelectorAll('[data-article-toc] a[href^="#"]').forEach((candidate) => {
        if (!(candidate instanceof HTMLAnchorElement)) return;
        let slug = '';
        try {
          slug = decodeURIComponent(new URL(candidate.href, location.href).hash.slice(1));
        } catch {
          return;
        }
        const active = slug === section.slug;
        candidate.classList.toggle('is-active-link', active);
        if (active) candidate.setAttribute('aria-current', 'location');
        else candidate.removeAttribute('aria-current');
      });
    })();
  </script>

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import 'photoswipe/style.css';
    import '../scripts/article-toc';

    let articleLightbox: PhotoSwipeLightbox | undefined;

    function setupImageLightbox() {
      articleLightbox?.destroy();
      articleLightbox = undefined;

      const article = document.querySelector<HTMLElement>('.article-prose');
      if (!article?.querySelector('[data-pswp-item]')) return;

      articleLightbox = new PhotoSwipeLightbox({
        gallery: article,
        children: 'a[data-pswp-item]',
        pswpModule: () => import('photoswipe'),
        bgOpacity: 0.92,
      });
      articleLightbox.init();
    }

    function teardownArticleEnhancements() {
      articleLightbox?.destroy();
      articleLightbox = undefined;
    }

    document.addEventListener('site:before-swap', teardownArticleEnhancements);
    document.addEventListener('site:page-load', () => {
      setupImageLightbox();
    });
    setupImageLightbox();
  </script>
</BaseLayout>
