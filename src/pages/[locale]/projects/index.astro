---
import ProjectListItem from '../../../components/ProjectListItem.astro';
import { getLocaleStaticPaths, type Locale } from '../../../i18n/config';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjects } from '../../../lib/projects';
import * as m from '../../../paraglide/messages.js';

type Props = { locale: Locale };
export const getStaticPaths = getLocaleStaticPaths;
const { locale } = Astro.props;
const projects = await getProjects(locale);
const projectTagsLabel = m.project_tags({}, { locale });
---

<BaseLayout
  title={m.projects_page_title({}, { locale })}
  description={m.projects_page_description({}, { locale })}
  {locale}
>
  <section class="content-shell py-12 sm:py-16">
    <div>
      <ol class="grid gap-6">
        {
          projects.map((project, index) => (
            <li>
              <ProjectListItem
                {project}
                tagsLabel={projectTagsLabel}
                showVisual
                reverse={index % 2 === 1}
              />
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
