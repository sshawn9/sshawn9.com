---
import { render } from 'astro:content';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { LOCALES, localePath, toLanguageTag, type Locale } from '../../../../i18n/config';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getArticleHref } from '../../../../lib/article-routes';
import { getProjectArticles, getProjects, type Project } from '../../../../lib/projects';
import * as m from '../../../../paraglide/messages.js';

type Props = { locale: Locale; project: Project };

export async function getStaticPaths() {
  const localizedProjects = await Promise.all(
    LOCALES.map(async (locale) => ({ locale, projects: await getProjects(locale) })),
  );

  return localizedProjects.flatMap(({ locale, projects }) =>
    projects.map((project) => ({
      params: { locale, id: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props;
const { Content } = await render(project.entry);
const relatedArticles = await getProjectArticles(project.id, locale);
const contentLanguage = toLanguageTag(project.contentLocale);
---

<BaseLayout title={project.title} description={project.description} {locale}>
  <section class="content-shell py-12 sm:py-16">
    <div class="mx-auto max-w-4xl">
      <Breadcrumbs
        items={[
          { label: m.nav_projects({}, { locale }), href: localePath(locale, '/projects/') },
          { label: project.title, lang: contentLanguage },
        ]}
        {locale}
      />

      <header class="mt-10 border-b border-slate-900/10 pb-10 dark:border-white/10">
        <h1
          class="text-4xl font-extrabold tracking-[-0.045em] text-balance sm:text-5xl"
          lang={contentLanguage}
        >
          {project.title}
        </h1>
        <p
          class="text-default mt-5 max-w-3xl text-base leading-8 sm:text-lg"
          lang={contentLanguage}
        >
          {project.description}
        </p>
        <ul
          class="text-supporting mt-6 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs"
          aria-label={m.project_tags({}, { locale })}
        >
          {project.tags.map((tag) => <li lang={contentLanguage}>#{tag}</li>)}
        </ul>
      </header>

      <article
        class="article-prose prose prose-lg mt-10 max-w-none prose-headings:tracking-tight prose-headings:text-balance prose-blockquote:not-italic"
        lang={contentLanguage}
      >
        <Content />
      </article>

      {
        relatedArticles.length > 0 && (
          <section
            class="mt-16 border-t border-slate-900/10 pt-10 dark:border-white/10"
            aria-labelledby="related-articles-heading"
          >
            <h2
              id="related-articles-heading"
              class="text-2xl font-extrabold tracking-tight sm:text-3xl"
            >
              {m.project_related_articles({}, { locale })}
            </h2>
            <ol class="mt-5 divide-y divide-slate-900/10 dark:divide-white/10">
              {relatedArticles.map((article) => {
                const entry = article.current.entry;
                const articleLanguage = toLanguageTag(article.current.contentLocale);

                return (
                  <li>
                    <article class="group relative py-6">
                      <div class="min-w-0" lang={articleLanguage}>
                        <h3 class="text-lg font-extrabold tracking-tight sm:text-xl">
                          <a
                            href={getArticleHref(article)}
                            class="interactive-heading after:absolute after:inset-0"
                          >
                            {entry.data.title}
                          </a>
                        </h3>
                        {entry.data.description && (
                          <p class="text-default mt-2 max-w-3xl text-sm leading-6">
                            {entry.data.description}
                          </p>
                        )}
                      </div>
                    </article>
                  </li>
                );
              })}
            </ol>
          </section>
        )
      }
    </div>
  </section>
</BaseLayout>
