---
import type { GetStaticPaths } from 'astro';
import BlogListing from '../../../components/BlogListing.astro';
import { LOCALES, type Locale } from '../../../i18n/config';
import { getVisibleArticles, type Article } from '../../../lib/articles';
import * as m from '@sshawn9/site-i18n/messages';

type Props = { locale: Locale; articles: Article[] };

export const getStaticPaths = (async () =>
  Promise.all(
    LOCALES.map(async (locale) => ({
      params: { locale },
      props: { locale, articles: await getVisibleArticles(locale) },
    })),
  )) satisfies GetStaticPaths;

const { locale, articles } = Astro.props;
---

<BlogListing
  description={m.blog_page_description({}, { locale })}
  pageTitle={m.blog_page_title({}, { locale })}
  {articles}
  {locale}
/>
