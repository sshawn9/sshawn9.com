---
import { getLocaleStaticPaths, type Locale } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import * as m from '../../paraglide/messages.js';

type Props = { locale: Locale };
export const getStaticPaths = getLocaleStaticPaths;
const { locale } = Astro.props;
---

<BaseLayout title={m.about_page_title({}, { locale })} {locale}>
  <section class="content-shell flex min-h-[60vh] items-center justify-center text-center">
    <p class="text-3xl font-semibold tracking-tight text-slate-700 sm:text-4xl dark:text-slate-300">
      {m.about_under_construction({}, { locale })}
    </p>
  </section>
</BaseLayout>
