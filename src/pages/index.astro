<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <title>Shawn</title>
    <script>
      import { getLocale } from '../paraglide/runtime.js';

      location.replace(`/${getLocale()}/${location.search}${location.hash}`);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: system-ui, sans-serif;
        background: #070a12;
        color: #e5e7eb;
      }
      main {
        text-align: center;
      }
      a {
        color: #67e8f9;
        margin: 0 0.75rem;
      }
    </style>
  </head>
  <body>
    <main>
      <p><span lang="en">Choose a language</span> / <span lang="zh-CN">选择语言</span></p>
      <a href="/en/" lang="en">English</a><a href="/zh/" lang="zh-CN">中文</a>
    </main>
  </body>
</html>
