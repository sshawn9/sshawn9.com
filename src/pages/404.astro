---
import '../styles/global.css';
import { ArrowLeft, Search } from '@lucide/astro';
import CloudflareWebAnalytics from '../components/CloudflareWebAnalytics.astro';
import * as m from '../paraglide/messages.js';

const text = {
  title: [m.not_found_title({}, { locale: 'en' }), m.not_found_title({}, { locale: 'zh' })],
  heading: [m.not_found_heading({}, { locale: 'en' }), m.not_found_heading({}, { locale: 'zh' })],
  body: [m.not_found_text({}, { locale: 'en' }), m.not_found_text({}, { locale: 'zh' })],
  home: [m.not_found_home({}, { locale: 'en' }), m.not_found_home({}, { locale: 'zh' })],
  search: [m.not_found_search({}, { locale: 'en' }), m.not_found_search({}, { locale: 'zh' })],
};
---

<!doctype html>
<html lang="en" data-locale="en" data-title-en={text.title[0]} data-title-zh={text.title[1]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#f7f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070a12" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{text.title[0]} — Shawn</title>
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        const storedTheme = localStorage.getItem('theme');
        const dark = storedTheme
          ? storedTheme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="page-background" aria-hidden="true"></div>
    <header
      class="relative z-10 border-b border-slate-900/10 bg-[color:rgb(247_248_251/0.96)] backdrop-blur-xl dark:border-white/10 dark:bg-[color:rgb(7_10_18/0.96)]"
    >
      <div class="content-shell flex h-17 items-center">
        <a
          data-localized-path="/"
          class="inline-flex items-center gap-3 text-[0.8rem] font-extrabold tracking-[0.055em]"
        >
          <span
            class="grid size-8 place-items-center rounded-[0.55rem] bg-slate-950 text-xs tracking-normal text-white dark:bg-white dark:text-slate-950"
            aria-hidden="true">S</span
          >
          <span>SHAWN</span>
        </a>
      </div>
    </header>
    <main class="relative z-10 grid flex-1 place-items-center px-5 py-20 text-center">
      <div data-reveal>
        <p class="text-accent font-mono text-sm font-bold tracking-[0.2em]">ERROR / 404</p>
        <h1
          class="mt-6 text-6xl font-extrabold tracking-[-0.06em] sm:text-8xl"
          data-en={text.heading[0]}
          data-zh={text.heading[1]}
        >
          {text.heading[0]}
        </h1>
        <p
          class="text-default mx-auto mt-6 max-w-xl text-base leading-7"
          data-en={text.body[0]}
          data-zh={text.body[1]}
        >
          {text.body[0]}
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a class="button-primary" data-localized-path="/">
            <ArrowLeft class="size-4" aria-hidden="true" />
            <span data-en={text.home[0]} data-zh={text.home[1]}>{text.home[0]}</span>
          </a>
          <a class="button-secondary" data-localized-path="/search/">
            <Search class="size-4" aria-hidden="true" />
            <span data-en={text.search[0]} data-zh={text.search[1]}>{text.search[0]}</span>
          </a>
        </div>
      </div>
    </main>
    <footer class="relative z-10 border-t border-slate-900/8 dark:border-white/8">
      <div class="content-shell py-8"><a data-localized-path="/">SHAWN</a></div>
    </footer>
    <script>
      import { getLocale } from '../paraglide/runtime.js';

      (() => {
        const routeLocale = location.pathname.match(/^\/(en|zh)(?:\/|$)/)?.[1];
        const locale = routeLocale === 'en' || routeLocale === 'zh' ? routeLocale : getLocale();
        document.documentElement.lang = locale === 'zh' ? 'zh-CN' : 'en';
        document.documentElement.dataset.locale = locale;
        const localizedTitle =
          locale === 'zh'
            ? document.documentElement.dataset.titleZh
            : document.documentElement.dataset.titleEn;
        if (localizedTitle) document.title = `${localizedTitle} — Shawn`;
        document.querySelectorAll('[data-en][data-zh]').forEach((element) => {
          element.textContent = element.getAttribute(`data-${locale}`) ?? '';
        });
        document.querySelectorAll('[data-localized-path]').forEach((link) => {
          const path = link.getAttribute('data-localized-path') ?? '/';
          link.setAttribute('href', `/${locale}${path}`);
        });
      })();
    </script>
    <CloudflareWebAnalytics />
  </body>
</html>
