---
import MotionControlProjectVisual from '@sshawn9/content-ui/motion-control-project-visual';
import { toLanguageTag } from '../i18n/config';
import type { Project } from '../lib/projects';

type Props = {
  project: Project;
  tagsLabel: string;
  headingLevel?: 'h2' | 'h3';
  showVisual?: boolean;
  reverse?: boolean;
};

const {
  project,
  tagsLabel,
  headingLevel = 'h2',
  showVisual = false,
  reverse = false,
} = Astro.props;
const Heading = headingLevel;
const contentLanguage = toLanguageTag(project.contentLocale);
const hasVisual = showVisual && project.id === 'autonomous-driving-motion-control';
---

<article
  class:list={[
    'project-list-item group relative overflow-hidden rounded-3xl p-6 sm:p-8',
    hasVisual &&
      'lg:grid lg:grid-cols-[minmax(15rem,0.6fr)_minmax(0,1.4fr)] lg:items-center lg:gap-6',
  ]}
  lang={contentLanguage}
  data-reveal
>
  <div class:list={['min-w-0', hasVisual && reverse && 'lg:order-2']}>
    <Heading class="text-2xl font-extrabold tracking-[-0.025em] text-balance sm:text-3xl">
      <a
        href={project.href}
        class:list={['interactive-heading', !hasVisual && 'after:absolute after:inset-0']}
      >
        {project.title}
      </a>
    </Heading>
    <p class="text-default mt-3 max-w-3xl text-sm leading-7 sm:text-base">
      {project.description}
    </p>
    {
      project.tags.length > 0 && (
        <ul
          class="text-supporting mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs"
          aria-label={tagsLabel}
        >
          {project.tags.map((tag) => (
            <li>#{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
  {
    hasVisual && (
      <div class:list={['mt-7 min-w-0 sm:mt-8 lg:mt-0', reverse ? 'lg:order-1' : 'lg:order-2']}>
        <MotionControlProjectVisual client:load />
      </div>
    )
  }
</article>

<style>
  .project-list-item {
    --project-card-surface: rgb(247 248 251 / 0.78);
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    background: var(--project-card-surface);
    box-shadow:
      inset 0 1px rgb(255 255 255 / 0.1),
      0 18px 50px rgb(7 10 18 / 0.08);
  }

  :global(.dark) .project-list-item {
    --project-card-surface: rgb(8 11 19 / 0.68);
  }
</style>
