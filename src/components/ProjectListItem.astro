---
import MotionControlProjectVisual from '../content/projects/autonomous-driving-motion-control/MotionControlProjectVisual';
import { toLanguageTag } from '../i18n/config';
import type { Project } from '../lib/projects';

type Props = {
  project: Project;
  tagsLabel: string;
  headingLevel?: 'h2' | 'h3';
  showVisual?: boolean;
  reverse?: boolean;
};

const {
  project,
  tagsLabel,
  headingLevel = 'h2',
  showVisual = false,
  reverse = false,
} = Astro.props;
const Heading = headingLevel;
const contentLanguage = toLanguageTag(project.contentLocale);
const hasVisual = showVisual && project.id === 'autonomous-driving-motion-control';
---

<article
  class:list={[
    'surface-strong group relative overflow-hidden rounded-3xl p-6 sm:p-8',
    hasVisual &&
      'lg:grid lg:grid-cols-[minmax(15rem,0.6fr)_minmax(0,1.4fr)] lg:items-center lg:gap-6',
  ]}
  lang={contentLanguage}
  data-reveal
>
  <div class:list={['min-w-0', hasVisual && reverse && 'lg:order-2']}>
    <Heading class="text-2xl font-extrabold tracking-[-0.025em] text-balance sm:text-3xl">
      <a
        href={project.href}
        class:list={[
          'transition-colors group-hover:text-cyan-700 dark:group-hover:text-cyan-300',
          !hasVisual && 'after:absolute after:inset-0',
        ]}
      >
        {project.title}
      </a>
    </Heading>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 sm:text-base dark:text-slate-400">
      {project.description}
    </p>
    {
      project.tags.length > 0 && (
        <ul
          class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-slate-500 dark:text-slate-400"
          aria-label={tagsLabel}
        >
          {project.tags.map((tag) => (
            <li>#{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
  {
    hasVisual && (
      <div class:list={['mt-7 min-w-0 sm:mt-8 lg:mt-0', reverse ? 'lg:order-1' : 'lg:order-2']}>
        <MotionControlProjectVisual client:load />
      </div>
    )
  }
</article>
