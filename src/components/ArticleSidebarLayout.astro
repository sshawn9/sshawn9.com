---
import type { Locale } from '../i18n/config';
import { ARTICLE_SIDEBAR_LAYOUT } from '../lib/site-preferences';
import * as m from '@sshawn9/site-i18n/messages';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const SIDEBAR_ID = 'article-sidebar';
const DEFAULT_WIDTH = ARTICLE_SIDEBAR_LAYOUT.defaultWidth;
const MIN_WIDTH = ARTICLE_SIDEBAR_LAYOUT.minWidth;
const MAX_WIDTH = ARTICLE_SIDEBAR_LAYOUT.maxWidth;
---

<div
  data-sidebar-layout
  data-article-sidebar-layout
  class="mx-auto block max-w-6xl lg:grid lg:grid-cols-[minmax(0,1fr)_2.5rem_var(--article-sidebar-track)] lg:items-start print:block"
  style={`--article-sidebar-width: var(--article-sidebar-current-width, var(--article-sidebar-boot-width, ${DEFAULT_WIDTH}px)); --article-sidebar-track: var(--article-sidebar-current-track, var(--article-sidebar-boot-track, var(--article-sidebar-width))); --article-sidebar-top: var(--site-article-sidebar-sticky-offset); --article-sidebar-bottom-gap: var(--site-sidebar-bottom-gap);`}
>
  <div class="min-w-0 pb-24" data-article-main>
    <slot name="main" />
  </div>

  <div
    data-sidebar-shell
    data-article-sidebar-shell
    class="relative hidden self-start lg:sticky lg:top-[var(--article-sidebar-top)] lg:col-span-2 lg:col-start-2 lg:row-start-1 lg:grid lg:grid-cols-[2.5rem_var(--article-sidebar-track)] print:hidden"
  >
    <div data-article-sidebar-rail class="relative self-stretch">
      <div
        role="separator"
        aria-label={m.article_sidebar_resize({}, { locale })}
        aria-controls={SIDEBAR_ID}
        aria-orientation="vertical"
        aria-valuemin={MIN_WIDTH}
        aria-valuemax={MAX_WIDTH}
        aria-valuenow={DEFAULT_WIDTH}
        tabindex="0"
        data-sidebar-resizer
        data-article-sidebar-resizer
        class="group absolute inset-y-0 -right-1.5 z-10 w-3 touch-none cursor-col-resize select-none focus-visible:outline-none"
      >
        <span
          aria-hidden="true"
          data-article-sidebar-boundary
          class="pointer-events-none absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-[var(--line)] transition-colors group-focus-visible:bg-[color-mix(in_srgb,var(--text-supporting)_34%,transparent)] group-data-[dragging]:bg-[color-mix(in_srgb,var(--text-supporting)_34%,transparent)]"
        ></span>
      </div>
    </div>

    <div data-article-sidebar-viewport class="min-w-0 overflow-clip">
      <aside
        id={SIDEBAR_ID}
        data-sidebar-panel
        class="w-full min-w-0"
        aria-label={m.article_supporting_information({}, { locale })}
        data-pagefind-ignore
        data-article-sidebar-column
      >
        <div
          class="flex max-h-[min(75dvh,calc(100dvh-var(--article-sidebar-top)-var(--article-sidebar-bottom-gap)))] w-[var(--article-sidebar-width)] flex-col"
        >
          <div
            class="article-sidebar-scrollbar min-h-0 flex-1 overflow-y-auto overscroll-contain pr-2 pb-2 pl-4 [scrollbar-gutter:stable]"
            data-article-sidebar-scroll
            data-scroll-restoration-key="article-sidebar"
          >
            <slot />
          </div>
        </div>
      </aside>
    </div>

    <div
      data-article-sidebar-controls
      class="pointer-events-none absolute -top-10 right-0 z-20 flex w-10 justify-end"
    >
      <button
        type="button"
        data-sidebar-toggle
        data-article-sidebar-collapse
        data-collapse-label={m.article_sidebar_collapse({}, { locale })}
        data-expand-label={m.article_sidebar_expand({}, { locale })}
        aria-label={m.article_sidebar_collapse({}, { locale })}
        aria-controls={SIDEBAR_ID}
        aria-expanded="true"
        class="text-supporting hover:text-strong focus-visible:text-strong pointer-events-auto inline-flex size-8 items-center justify-center rounded-md transition-colors"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-[1.125rem]"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
          <path d="M15 3v18"></path>
          <path data-article-sidebar-collapse-icon d="m8 9 3 3-3 3"></path>
          <path data-article-sidebar-expand-icon d="m10 9-3 3 3 3"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  import '../scripts/article-sidebar';
</script>
