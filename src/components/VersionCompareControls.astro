---
import { ChevronDown, Columns2, GitCompareArrows, List } from '@lucide/astro';
import { formatDate } from '../lib/date';
import { getArticleCompareHref } from '../lib/article-routes';
import { getVersionDate, type Article, type ArticleVersion } from '../lib/articles';
import * as m from '../paraglide/messages.js';

type Props = {
  article: Article;
  from: ArticleVersion;
  to: ArticleVersion;
  variant?: 'desktop' | 'mobile';
};

const { article, from, to, variant = 'desktop' } = Astro.props;
const versions = article.versions.toReversed();
const locale = article.locale;
const base = to;
const versionListId = `compare-version-list-${variant}`;
---

<div>
  <section aria-labelledby={`diff-view-heading-${variant}`}>
    <h2
      id={`diff-view-heading-${variant}`}
      class="font-mono text-[0.65rem] font-bold tracking-[0.16em] text-slate-500 dark:text-slate-400"
    >
      {m.version_display_mode({}, { locale })}
    </h2>
    <div
      class="mt-3 grid grid-cols-2 rounded-xl bg-slate-900/[0.045] p-1 dark:bg-white/[0.055]"
      role="group"
      aria-label={m.version_display_mode_label({}, { locale })}
    >
      <label
        for="diff-mode-unified"
        data-diff-mode-label="unified"
        class="inline-flex min-h-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg px-2 text-xs font-bold text-slate-600 transition-colors dark:text-slate-300"
      >
        <List class="size-3.5" aria-hidden="true" />
        {m.version_unified({}, { locale })}
      </label>
      <label
        for="diff-mode-split"
        data-diff-mode-label="split"
        class="inline-flex min-h-9 cursor-pointer items-center justify-center gap-1.5 rounded-lg px-2 text-xs font-bold text-slate-600 transition-colors dark:text-slate-300"
      >
        <Columns2 class="size-3.5" aria-hidden="true" />
        {m.version_split({}, { locale })}
      </label>
    </div>
  </section>

  <section
    class="mt-7 border-t border-slate-900/10 pt-6 dark:border-white/10"
    aria-labelledby={`compare-options-heading-${variant}`}
  >
    <h2
      id={`compare-options-heading-${variant}`}
      class="font-mono text-[0.65rem] font-bold tracking-[0.16em] text-slate-500 dark:text-slate-400"
    >
      {m.version_compare_heading({}, { locale })}
    </h2>
    <p class="mt-3 text-xs leading-5 text-slate-500 dark:text-slate-400">
      <span
        set:html={m
          .version_base_label({ version: '__VERSION__' }, { locale })
          .replace(
            '__VERSION__',
            `<strong class="text-slate-900 dark:text-white">v${base.number}</strong>`,
          )}
      />
    </p>

    <button
      type="button"
      popovertarget={versionListId}
      class="group mt-2 flex min-h-9 w-full items-center gap-2 text-xs font-bold text-slate-600 transition-colors hover:text-violet-700 dark:text-slate-300 dark:hover:text-violet-300"
    >
      <GitCompareArrows class="size-4" aria-hidden="true" />
      {m.version_compare_other({}, { locale })}
      <ChevronDown
        class="ml-auto size-4 transition-transform group-aria-expanded:rotate-180"
        aria-hidden="true"
      />
    </button>

    <div
      id={versionListId}
      popover
      class="modal-popover surface-strong fixed top-1/2 left-1/2 m-0 w-[min(24rem,calc(100%_-_2rem))] -translate-x-1/2 -translate-y-1/2 rounded-2xl p-5 shadow-2xl"
    >
      <h3 class="text-sm font-extrabold">{m.version_choose_other({}, { locale })}</h3>
      <ol class="mt-4 grid gap-0.5" aria-label={m.version_choose_other({}, { locale })}>
        {
          versions.map((version) => {
            const isBase = version.number === base.number;
            const isCurrentPair = version.number === from.number;

            return (
              <li>
                {isBase ? (
                  <span
                    class="flex min-h-9 cursor-not-allowed items-center gap-3 rounded-lg px-2 text-xs text-slate-400 dark:text-slate-600"
                    aria-disabled="true"
                  >
                    <span class="font-bold">v{version.number}</span>
                    <time class="ml-auto font-mono text-[0.6rem] font-normal">
                      {formatDate(getVersionDate(version), locale)}
                    </time>
                  </span>
                ) : (
                  <a
                    href={getArticleCompareHref(article, base, version)}
                    aria-current={isCurrentPair ? 'page' : undefined}
                    class:list={[
                      'flex min-h-9 items-center gap-3 rounded-lg px-2 text-xs text-slate-600 transition-colors hover:bg-violet-500/8 hover:text-violet-700 dark:text-slate-300 dark:hover:text-violet-300',
                      isCurrentPair && 'font-extrabold text-slate-950 dark:text-white',
                    ]}
                  >
                    <span>v{version.number}</span>
                    <time class="ml-auto font-mono text-[0.6rem] font-normal text-slate-400 dark:text-slate-500">
                      {formatDate(getVersionDate(version), locale)}
                    </time>
                  </a>
                )}
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</div>
