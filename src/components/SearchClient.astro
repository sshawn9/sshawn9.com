---
import { toLanguageTag, type Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = { locale: Locale };
const { locale } = Astro.props;
const pagefindInstance = `site-${locale}`;
---

<div class="surface pagefind-search rounded-3xl p-5 sm:p-8">
  <pagefind-config
    instance={pagefindInstance}
    lang={toLanguageTag(locale).toLowerCase()}
    excerpt-length="36"
    preload></pagefind-config>
  <pagefind-input instance={pagefindInstance} placeholder={m.search_placeholder({}, { locale })}
  ></pagefind-input>
  <pagefind-summary instance={pagefindInstance}></pagefind-summary>
  <pagefind-results instance={pagefindInstance}></pagefind-results>
</div>

<script is:inline src="/pagefind/pagefind-component-ui.js" type="module"></script>
