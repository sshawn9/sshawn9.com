---
import type { Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type BreadcrumbItem = {
  label: string;
  href?: string;
  lang?: string;
};

type Props = {
  items: BreadcrumbItem[];
  locale: Locale;
};

const { items, locale } = Astro.props;
---

<nav aria-label={m.breadcrumbs({}, { locale })} data-pagefind-ignore>
  <ol class="text-supporting flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold">
    {
      items.map((item, index) => {
        const current = index === items.length - 1;

        return (
          <li class="contents">
            {index > 0 && <span aria-hidden="true">/</span>}
            {item.href && !current ? (
              <a href={item.href} lang={item.lang} class="interactive-supporting">
                {item.label}
              </a>
            ) : (
              <span
                aria-current={current ? 'page' : undefined}
                lang={item.lang}
                class={current ? 'text-strong' : undefined}
              >
                {item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
