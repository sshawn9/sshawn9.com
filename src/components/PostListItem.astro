---
import { ArrowUpRight } from '@lucide/astro';
import { formatDate } from '../lib/date';
import { toLanguageTag } from '../i18n/config';
import { getArticleHref } from '../lib/article-routes';
import { getTagName, type Article } from '../lib/articles';
import * as m from '../paraglide/messages.js';

type Props = { article: Article };
const { article } = Astro.props;
const post = article.current.entry;
const publishedAt = article.versions[0].entry.data.publishedAt;
const revisedAt = article.current.entry.data.revisedAt;
const locale = article.locale;
---

<article
  lang={toLanguageTag(article.current.contentLocale)}
  class="group grid gap-4 border-b border-slate-900/10 py-7 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-7 lg:grid-cols-[9rem_minmax(0,1fr)_minmax(12rem,18rem)_1.5rem] lg:items-start dark:border-white/10"
>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 sm:block">
    <time
      datetime={publishedAt.toISOString()}
      class="font-mono text-xs font-bold text-slate-600 dark:text-slate-300"
    >
      {formatDate(publishedAt, locale)}
    </time>
    {
      revisedAt && (
        <time
          datetime={revisedAt.toISOString()}
          class="font-mono text-[0.62rem] text-slate-500 sm:mt-2 sm:block dark:text-slate-400"
        >
          {m.blog_updated_on({ date: formatDate(revisedAt, locale) }, { locale })}
        </time>
      )
    }
  </div>

  <div class="min-w-0">
    <h2 class="text-xl font-extrabold tracking-tight sm:text-2xl">
      <a
        href={getArticleHref(article)}
        class="transition-colors group-hover:text-cyan-700 dark:group-hover:text-cyan-300"
      >
        {post.data.title}
      </a>
    </h2>
    <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-600 dark:text-slate-400">
      {post.data.description}
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-2 sm:col-start-2 lg:col-start-auto">
    {
      post.data.tags.map((tag) => (
        <span class="rounded-full bg-cyan-500/8 px-2.5 py-1 font-mono text-[0.62rem] text-cyan-700 dark:text-cyan-300">
          #{getTagName(tag)}
        </span>
      ))
    }
  </div>

  <a
    href={getArticleHref(article)}
    class="hidden text-slate-400 transition-[color,transform] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-cyan-600 lg:block dark:group-hover:text-cyan-300"
    aria-label={m.blog_read_article({ title: post.data.title }, { locale })}
  >
    <ArrowUpRight class="size-4" aria-hidden="true" />
  </a>
</article>
