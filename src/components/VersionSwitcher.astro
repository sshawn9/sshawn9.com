---
import { ChevronDown } from '@lucide/astro';
import { toLanguageTag } from '../i18n/config';
import { formatDate } from '../lib/date';
import * as m from '../paraglide/messages.js';
import {
  getArticleCompareHref,
  getArticleHref,
  getArticleVersionHref,
} from '../lib/article-routes';
import { getVersionDate, type Article, type ArticleVersion } from '../lib/articles';

type Props = {
  article: Article;
  selected: ArticleVersion;
  variant?: 'desktop' | 'mobile';
};

const { article, selected, variant = 'desktop' } = Astro.props;
const versions = article.versions.toReversed();
const locale = article.locale;
const headingId = `article-versions-${variant}`;
const comparisonId = `article-version-comparison-${variant}`;
---

<section aria-labelledby={headingId} data-pagefind-ignore>
  <h2 id={headingId} class="sidebar-heading">
    {m.version_heading({}, { locale })}
  </h2>

  <ol class="mt-4 border-l border-slate-900/10 dark:border-white/10">
    {
      versions.map((version) => {
        const isSelected = version.number === selected.number;
        const isLatest = version.number === article.current.number;
        const href = isLatest ? getArticleHref(article) : getArticleVersionHref(article, version);

        return (
          <li>
            <a
              href={href}
              aria-current={isSelected ? 'page' : undefined}
              class:list={[
                '-ml-px block border-l py-1.5 pl-4 text-xs leading-5 transition-colors hover:border-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300',
                isSelected
                  ? 'border-cyan-400 text-cyan-700 dark:text-cyan-300'
                  : 'border-transparent text-slate-500 dark:text-slate-400',
              ]}
            >
              <span class="flex items-baseline gap-3">
                <span class={isLatest ? 'font-extrabold' : 'font-medium'}>v{version.number}</span>
                <time
                  class:list={[
                    'ml-auto font-mono text-[0.6rem] font-normal',
                    isSelected
                      ? 'text-cyan-700/70 dark:text-cyan-300/70'
                      : 'text-slate-400 dark:text-slate-500',
                  ]}
                  datetime={getVersionDate(version).toISOString()}
                >
                  {formatDate(getVersionDate(version), locale)}
                </time>
              </span>
              <span
                lang={toLanguageTag(version.contentLocale)}
                class:list={[
                  'mt-0.5 line-clamp-2 block text-[0.68rem] leading-5 font-normal',
                  isSelected
                    ? 'text-cyan-700/80 dark:text-cyan-300/80'
                    : 'text-slate-500 dark:text-slate-400',
                ]}
              >
                {version.entry.data.revisionSummary ?? m.version_first_release({}, { locale })}
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>

  <div class="mt-7 border-t border-slate-900/10 pt-6 dark:border-white/10">
    <button
      type="button"
      popovertarget={comparisonId}
      class="sidebar-heading group flex w-full items-center transition-colors hover:text-cyan-700 dark:hover:text-cyan-300"
    >
      {m.version_compare_heading({}, { locale })}
      <ChevronDown
        class="ml-auto size-4 transition-transform group-aria-expanded:rotate-180"
        aria-hidden="true"
      />
    </button>

    <div
      id={comparisonId}
      popover
      class="modal-popover surface-strong fixed top-1/2 left-1/2 m-0 w-[min(24rem,calc(100%_-_2rem))] -translate-x-1/2 -translate-y-1/2 rounded-2xl p-5 shadow-2xl"
    >
      <h3 class="text-sm font-extrabold">{m.version_choose_comparison({}, { locale })}</h3>
      <ol
        class="mt-4 border-l border-slate-900/10 dark:border-white/10"
        aria-label={m.version_choose_comparison({}, { locale })}
      >
        {
          versions.map((version) => {
            const isSelected = version.number === selected.number;

            return (
              <li>
                {isSelected ? (
                  <span
                    class="-ml-px flex items-center gap-3 border-l border-transparent py-2 pl-4 text-xs leading-5 text-slate-400 dark:text-slate-600"
                    aria-disabled="true"
                  >
                    <span class="font-bold">v{version.number}</span>
                    <time class="ml-auto font-mono text-[0.6rem]">
                      {formatDate(getVersionDate(version), locale)}
                    </time>
                  </span>
                ) : (
                  <a
                    data-version-compare-link
                    class="-ml-px flex items-center gap-3 border-l border-transparent py-2 pl-4 text-xs leading-5 font-semibold text-slate-500 transition-colors hover:border-cyan-400 hover:text-cyan-700 dark:text-slate-400 dark:hover:text-cyan-300"
                    href={getArticleCompareHref(article, selected, version)}
                  >
                    <span>v{version.number}</span>
                    <time class="ml-auto font-mono text-[0.6rem] font-normal text-slate-400 dark:text-slate-500">
                      {formatDate(getVersionDate(version), locale)}
                    </time>
                  </a>
                )}
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>
