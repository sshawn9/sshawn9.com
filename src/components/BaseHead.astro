---
import { SEO } from 'astro-seo';
import { Schema } from 'astro-seo-schema';
import { Font } from 'astro:assets';
import { SITE_MODE } from 'astro:env/server';
import type { Person, WithContext } from 'schema-dts';
import { SITE } from '../config';
import {
  BASE_LOCALE,
  LOCALES,
  replacePathLocale,
  toLanguageTag,
  type Locale,
} from '../i18n/config';
import * as m from '@sshawn9/site-i18n/messages';
import { FONT_REVISION } from '../lib/font-revision.server';
import { TYPOGRAPHY_TIMEOUT_MS } from '../lib/typography-contract';
import PrepaintState from './PrepaintState.astro';

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  locale?: Locale;
  alternateLocales?: Locale[];
};

const {
  locale = BASE_LOCALE,
  title = m.site_title({}, { locale }),
  description: providedDescription,
  canonical,
  image,
  type = 'website',
  noIndex = false,
  alternateLocales = [...LOCALES],
} = Astro.props;
const description =
  providedDescription ?? (type === 'article' ? undefined : m.site_description({}, { locale }));
const shouldNoIndex = noIndex || SITE_MODE === 'preview';
const siteTitle = m.site_title({}, { locale });
const pageTitle = title === siteTitle ? title : `${title} — ${SITE.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const socialImage = image ? new URL(image, Astro.site ?? SITE.url).toString() : undefined;
const languageAlternates: Array<{ hrefLang: string; href: string }> = alternateLocales.map(
  (alternateLocale) => ({
    hrefLang: toLanguageTag(alternateLocale),
    href: new URL(
      replacePathLocale(Astro.url.pathname, alternateLocale),
      Astro.site ?? SITE.url,
    ).toString(),
  }),
);
const xDefaultLocale = alternateLocales.includes(BASE_LOCALE)
  ? BASE_LOCALE
  : (alternateLocales[0] ?? BASE_LOCALE);
languageAlternates.push({
  hrefLang: 'x-default',
  href: new URL(
    replacePathLocale(Astro.url.pathname, xDefaultLocale),
    Astro.site ?? SITE.url,
  ).toString(),
});
const person: WithContext<Person> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  sameAs: [SITE.github],
};
const openGraphLocale = (targetLocale: Locale) => (targetLocale === 'zh' ? 'zh_CN' : 'en_US');
const openGraphLocaleAlternates = alternateLocales
  .filter((alternateLocale) => alternateLocale !== locale)
  .map(openGraphLocale);
const openGraph = socialImage
  ? {
      basic: { title: pageTitle, type, image: socialImage, url: canonicalUrl },
      optional: {
        description,
        locale: openGraphLocale(locale),
        localeAlternate: openGraphLocaleAlternates,
        siteName: SITE.name,
      },
    }
  : undefined;
---

<SEO
  charset="UTF-8"
  title={pageTitle}
  {description}
  canonical={canonicalUrl}
  noindex={shouldNoIndex}
  {languageAlternates}
  {openGraph}
  twitter={{
    card: socialImage ? 'summary_large_image' : 'summary',
    title: pageTitle,
    description,
    image: socialImage,
  }}
  extend={{
    meta: socialImage
      ? []
      : [
          { property: 'og:type', content: type },
          { property: 'og:site_name', content: SITE.name },
          { property: 'og:title', content: pageTitle },
          ...(description ? [{ property: 'og:description', content: description }] : []),
          { property: 'og:url', content: canonicalUrl },
          { property: 'og:locale', content: openGraphLocale(locale) },
          ...openGraphLocaleAlternates.map((alternateLocale) => ({
            property: 'og:locale:alternate',
            content: alternateLocale,
          })),
        ],
  }}
/>
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#f7f8fb" />
<Font cssVariable="--font-manrope" preload={[{ weight: '200 800', style: 'normal' }]} />
<Font cssVariable="--font-source-sans-3" preload={[{ weight: '200 900', style: 'normal' }]} />
<PrepaintState fontRevision={FONT_REVISION} fontFailsafeMs={TYPOGRAPHY_TIMEOUT_MS + 1_000} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href={`/site.${locale}.webmanifest`} />
<Schema item={person} />
