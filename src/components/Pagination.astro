---
import type { Page } from 'astro';
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import type { Article } from '../lib/articles';
import * as m from '../paraglide/messages.js';

type Props = { page: Page<Article>; locale: Locale };
const { page, locale } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-10 flex items-center justify-between gap-4 border-t border-slate-900/10 pt-6 dark:border-white/10"
      aria-label={m.pagination_label({}, { locale })}
    >
      <div>
        {page.url.prev && (
          <a
            href={page.url.prev}
            class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 transition-colors hover:text-cyan-700 dark:text-slate-300 dark:hover:text-cyan-300"
            rel="prev"
          >
            <ArrowLeft class="size-4" aria-hidden="true" />
            {m.pagination_previous({}, { locale })}
          </a>
        )}
      </div>
      <span class="font-mono text-xs text-slate-500 dark:text-slate-400">
        {m.blog_page_count(
          { count: page.total, current: page.currentPage, total: page.lastPage },
          { locale },
        )}
      </span>
      <div>
        {page.url.next && (
          <a
            href={page.url.next}
            class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 transition-colors hover:text-cyan-700 dark:text-slate-300 dark:hover:text-cyan-300"
            rel="next"
          >
            {m.pagination_next({}, { locale })}
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        )}
      </div>
    </nav>
  )
}
