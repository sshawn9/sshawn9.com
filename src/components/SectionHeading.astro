---
type Props = {
  eyebrow: string;
  title: string;
  description?: string;
};

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-4 text-3xl font-extrabold tracking-[-0.035em] text-balance sm:text-4xl">{title}</h2>
  {
    description && (
      <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-400">{description}</p>
    )
  }
</div>
