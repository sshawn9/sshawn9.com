---
import { Languages } from '@lucide/astro';
import { otherLocale, replacePathLocale, type Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = { locale: Locale };
const { locale } = Astro.props;
const targetLocale = otherLocale(locale);
const targetLanguage =
  targetLocale === 'zh' ? m.language_chinese({}, { locale }) : m.language_english({}, { locale });
const label = m.language_switch_to({ language: targetLanguage }, { locale });
const href = `${replacePathLocale(Astro.url.pathname, targetLocale)}${Astro.url.search}`;
---

<a
  href={href}
  data-locale-switch={targetLocale}
  class="icon-control"
  aria-label={label}
  title={label}
>
  <Languages class="size-[1.05rem]" aria-hidden="true" />
</a>

<script>
  import { navigate } from 'astro:transitions/client';
  import { localStorageKey } from '../paraglide/runtime.js';

  type ScrollPosition = { left: number; top: number };
  let pendingLocaleScroll: ScrollPosition | undefined;

  document.addEventListener('astro:after-swap', () => {
    const position = pendingLocaleScroll;
    pendingLocaleScroll = undefined;
    if (!position) return;

    window.scrollTo({ ...position, behavior: 'instant' });
  });

  document.addEventListener(
    'click',
    (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) {
        return;
      }

      const target = event.target;
      const link =
        target instanceof Element
          ? target.closest<HTMLAnchorElement>('[data-locale-switch]')
          : null;
      const locale = link?.dataset.localeSwitch;
      if (!link || (locale !== 'en' && locale !== 'zh')) return;

      localStorage.setItem(localStorageKey, locale);
      event.preventDefault();
      const position = { left: window.scrollX, top: window.scrollY };
      const destination = new URL(link.href);
      destination.search = window.location.search;
      destination.hash = '';
      pendingLocaleScroll = position;
      void navigate(destination.href, { sourceElement: link }).finally(() => {
        if (pendingLocaleScroll === position) pendingLocaleScroll = undefined;
      });
    },
    { capture: true },
  );
</script>
