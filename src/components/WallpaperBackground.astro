---
import type { Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<div class="wallpaper" data-wallpaper>
  <div
    class="wallpaper__images"
    data-wallpaper-media
    aria-hidden="true"
    transition:persist="wallpaper-images"
  >
    <img
      class="wallpaper__image"
      data-wallpaper-image
      alt=""
      decoding="async"
      fetchpriority="low"
      draggable="false"
    />
    <img
      class="wallpaper__image"
      data-wallpaper-image
      alt=""
      decoding="async"
      fetchpriority="low"
      draggable="false"
    />
    <div class="wallpaper__scrim"></div>
  </div>

  <div class="wallpaper__credit" data-wallpaper-credit hidden>
    <span>{m.wallpaper_photo_by({}, { locale })}</span>{' '}
    <a data-wallpaper-photographer target="_blank" rel="noreferrer"></a>{' '}
    <span>{m.wallpaper_on({}, { locale })}</span>{' '}
    <a data-wallpaper-source target="_blank" rel="noreferrer">Unsplash</a>
  </div>
</div>
