---
import { Menu, Search, X } from '@lucide/astro';
import { SITE } from '../config';
import { localePath, type Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import WallpaperControl from './WallpaperControl.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const homeHref = localePath(locale);
const searchHref = localePath(locale, '/search/');
const navItems = [
  { href: localePath(locale, '/projects/'), label: m.nav_projects({}, { locale }) },
  { href: localePath(locale, '/blog/'), label: m.nav_blog({}, { locale }) },
  { href: localePath(locale, '/about/'), label: m.nav_about({}, { locale }) },
];
const isActive = (href: string) => pathname === href || pathname.startsWith(href);
---

<header
  class="site-header"
  data-pagefind-ignore
  transition:name="site-header"
  transition:animate="none"
>
  <div class="site-header__inner content-shell">
    <a
      href={homeHref}
      class="site-header__identity"
      aria-label={`${SITE.name} · ${m.home({}, { locale })}`}
      aria-current={pathname === homeHref ? 'page' : undefined}
    >
      <span class="site-header__monogram" aria-hidden="true">S</span>
      <span>SHAWN</span>
    </a>

    <div class="site-header__desktop">
      <nav class="site-header__primary-nav" aria-label={m.nav_main({}, { locale })}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="site-header__nav-link"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="site-header__utilities">
        <a
          href={searchHref}
          class="icon-control"
          aria-label={m.nav_search({}, { locale })}
          title={m.nav_search({}, { locale })}
          aria-current={isActive(searchHref) ? 'page' : undefined}
        >
          <Search class="size-[1.05rem]" aria-hidden="true" />
        </a>
        <LocaleSwitcher {locale} />
        <div class="site-header__appearance">
          <ThemeToggle {locale} />
          <WallpaperControl {locale} id="wallpaper-controls-desktop" />
        </div>
        <a
          href={SITE.github}
          target="_blank"
          rel="noreferrer"
          class="icon-control"
          aria-label={m.github_profile({}, { locale })}
          title="GitHub"
        >
          <svg class="size-[1.05rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .297a12 12 0 0 0-3.795 23.385c.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57A12 12 0 0 0 12 .297Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <button type="button" popovertarget="site-navigation" class="site-header__menu-button">
      <Menu class="site-header__menu-open size-5" aria-hidden="true" />
      <X class="site-header__menu-close size-5" aria-hidden="true" />
      <span class="site-header__menu-open sr-only">{m.open_navigation({}, { locale })}</span>
      <span class="site-header__menu-close sr-only">{m.close_navigation({}, { locale })}</span>
    </button>

    <div id="site-navigation" popover class="site-header__mobile-panel">
      <nav class="site-header__mobile-nav" aria-label={m.nav_mobile({}, { locale })}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="site-header__mobile-link"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={searchHref}
          aria-current={isActive(searchHref) ? 'page' : undefined}
          class="site-header__mobile-link site-header__mobile-search"
        >
          <Search class="size-4" aria-hidden="true" />
          <span>{m.nav_search({}, { locale })}</span>
        </a>
      </nav>

      <div class="site-header__mobile-utilities">
        <LocaleSwitcher {locale} />
        <ThemeToggle {locale} />
        <WallpaperControl {locale} id="wallpaper-controls-mobile" />
        <a
          href={SITE.github}
          target="_blank"
          rel="noreferrer"
          class="icon-control"
          aria-label={m.github_profile({}, { locale })}
          title="GitHub"
        >
          <svg class="size-[1.05rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .297a12 12 0 0 0-3.795 23.385c.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57A12 12 0 0 0 12 .297Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--page) 24%, transparent);
    backdrop-filter: blur(14px) saturate(0.9);
  }

  .site-header__inner {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    gap: 1.75rem;
  }

  .site-header__identity {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.055em;
    text-decoration: none;
  }

  .site-header__monogram {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: 0.55rem;
    background: var(--ink);
    color: var(--page);
    font-size: 0.75rem;
    letter-spacing: 0;
  }

  .site-header__desktop {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: stretch;
    justify-content: space-between;
    align-self: stretch;
  }

  .site-header__primary-nav,
  .site-header__utilities,
  .site-header__appearance {
    display: flex;
    align-items: center;
  }

  .site-header__primary-nav {
    gap: 0.375rem;
  }

  .site-header__nav-link {
    display: inline-flex;
    min-height: 1.875rem;
    align-items: center;
    border-radius: 999px;
    padding-inline: 0.8rem;
    color: var(--text-default);
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .site-header__nav-link:hover {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    color: var(--ink);
  }

  .site-header__nav-link[aria-current='page'] {
    background: var(--ink);
    color: var(--page);
  }

  .site-header__utilities {
    gap: 0.2rem;
  }

  .site-header__appearance {
    margin-inline: 0.25rem;
    padding-inline: 0.25rem;
    border-inline: 1px solid var(--line);
  }

  .site-header :global(.icon-control) {
    width: 2rem;
    height: 2rem;
  }

  .site-header__menu-button {
    display: none;
    width: 2rem;
    height: 2rem;
    flex: none;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: transparent;
    color: var(--ink);
  }

  .site-header__menu-close {
    display: none;
  }

  .site-header__menu-button:has(+ .site-header__mobile-panel:popover-open) .site-header__menu-open {
    display: none;
  }

  .site-header__menu-button:has(+ .site-header__mobile-panel:popover-open)
    .site-header__menu-close {
    display: block;
  }

  .site-header__mobile-panel {
    position: fixed;
    inset: calc(3.5rem + env(safe-area-inset-top)) max(1rem, env(safe-area-inset-right)) auto auto;
    width: min(22rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 4.5rem - env(safe-area-inset-top));
    margin: 0;
    overflow-y: auto;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--page) 84%, transparent);
    color: var(--ink);
    box-shadow: 0 20px 60px rgb(7 10 18 / 0.24);
    backdrop-filter: blur(18px) saturate(0.94);
  }

  .site-header__mobile-panel::backdrop {
    background: rgb(7 10 18 / 0.18);
  }

  .site-header__mobile-nav {
    display: grid;
    gap: 0.2rem;
    padding: 0.65rem;
  }

  .site-header__mobile-link {
    display: flex;
    min-height: 2.85rem;
    align-items: center;
    gap: 0.65rem;
    border-radius: 0.75rem;
    padding-inline: 0.85rem;
    color: var(--text-default);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-header__mobile-link:hover {
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    color: var(--ink);
  }

  .site-header__mobile-link[aria-current='page'] {
    background: var(--ink);
    color: var(--page);
  }

  .site-header__mobile-search {
    margin-top: 0.45rem;
    padding-top: 0.1rem;
    border-top: 1px solid var(--line);
    border-radius: 0;
  }

  .site-header__mobile-utilities {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.65rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 47.999rem) {
    .site-header__inner {
      min-height: 3.5rem;
      justify-content: space-between;
      gap: 1rem;
    }

    .site-header__desktop {
      display: none;
    }

    .site-header__menu-button {
      display: inline-flex;
    }

    .site-header__mobile-panel {
      inset-block-start: calc(3.5rem + env(safe-area-inset-top));
    }
  }

  @media (min-width: 48rem) {
    .site-header__mobile-panel,
    .site-header__menu-button {
      display: none;
    }
  }

  @media (max-height: 32rem), (max-width: 47.999rem) and (orientation: landscape) {
    .site-header {
      position: relative;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__nav-link {
      transition: none;
    }
  }
</style>
