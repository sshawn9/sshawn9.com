---
import { SITE } from '../config';
import {
  localePath,
  otherLocale,
  replacePathLocale,
  toLanguageTag,
  type Locale,
} from '../i18n/config';
import * as m from '@sshawn9/site-i18n/messages';
import SiteChrome, { type SiteChromeProps } from './SiteChrome';

type Props = { locale: Locale };
const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const homeHref = localePath(locale);
const searchHref = localePath(locale, '/search/');
const targetLocale = otherLocale(locale);
const targetLanguage =
  targetLocale === 'zh' ? m.language_chinese({}, { locale }) : m.language_english({}, { locale });
const isActive = (href: string) => pathname === href || pathname.startsWith(href);

const chromeProps: SiteChromeProps = {
  locale,
  languageTag: toLanguageTag(locale),
  pathname,
  homeHref,
  homeActive: pathname === homeHref,
  searchHref,
  searchActive: isActive(searchHref),
  localeHref: `${replacePathLocale(pathname, targetLocale)}${Astro.url.search}`,
  targetLocale,
  localeLabel: m.language_switch_to({ language: targetLanguage }, { locale }),
  githubHref: SITE.github,
  navItems: [
    {
      id: 'projects',
      href: localePath(locale, '/projects/'),
      label: m.nav_projects({}, { locale }),
      active: isActive(localePath(locale, '/projects/')),
    },
    {
      id: 'blog',
      href: localePath(locale, '/blog/'),
      label: m.nav_blog({}, { locale }),
      active: isActive(localePath(locale, '/blog/')),
    },
    {
      id: 'about',
      href: localePath(locale, '/about/'),
      label: m.nav_about({}, { locale }),
      active: isActive(localePath(locale, '/about/')),
    },
  ],
  labels: {
    skipToContent: m.skip_to_content({}, { locale }),
    mainNavigation: m.nav_main({}, { locale }),
    mobileNavigation: m.nav_mobile({}, { locale }),
    home: m.home({}, { locale }),
    search: m.nav_search({}, { locale }),
    openNavigation: m.open_navigation({}, { locale }),
    closeNavigation: m.close_navigation({}, { locale }),
    navigationLoading: m.navigation_loading({}, { locale }),
    githubProfile: m.github_profile({}, { locale }),
    themeToggle: m.theme_toggle({}, { locale }),
    themeToLight: m.theme_to_light({}, { locale }),
    themeToDark: m.theme_to_dark({}, { locale }),
    wallpaperControls: m.wallpaper_controls({}, { locale }),
    wallpaperUseRandom: m.wallpaper_use_random({}, { locale }),
    wallpaperAutoRotation: m.wallpaper_auto_rotation({}, { locale }),
    wallpaperRefresh: m.wallpaper_refresh({}, { locale }),
    wallpaperDownload: m.wallpaper_download({}, { locale }),
    wallpaperPhotoBy: m.wallpaper_photo_by({}, { locale }),
    wallpaperOn: m.wallpaper_on({}, { locale }),
  },
};
const chromeContext = JSON.stringify(chromeProps).replaceAll('<', '\\u003c');
---

<SiteChrome client:load {...chromeProps} />
<script is:inline id="site-chrome-context" type="application/json" set:html={chromeContext} />

<script is:inline data-swup-ignore-script>
  (() => {
    const credit = document.querySelector('[data-wallpaper-credit]');
    const photo = window.__SSHawn9SiteBootstrap?.wallpaper.currentPhoto;
    const enabled = window.__SSHawn9SiteBootstrap?.wallpaper.enabled === true;
    const validPhoto =
      photo !== null &&
      typeof photo === 'object' &&
      typeof photo.id === 'string' &&
      typeof photo.createdAt === 'string' &&
      Number.isFinite(Date.parse(photo.createdAt)) &&
      typeof photo.blurHash === 'string' &&
      photo.blurHash.length > 0 &&
      typeof photo.rawUrl === 'string' &&
      typeof photo.photographerName === 'string' &&
      typeof photo.photographerUrl === 'string' &&
      typeof photo.photoUrl === 'string';
    if (!(credit instanceof HTMLElement) || !enabled || !validPhoto) return;

    const photographerName = photo.photographerName;
    const photographerUrl = photo.photographerUrl;
    const photoUrl = photo.photoUrl;
    const photographer = credit.querySelector('[data-wallpaper-credit-photographer]');
    const source = credit.querySelector('[data-wallpaper-credit-photo]');
    if (
      !(photographer instanceof HTMLAnchorElement) ||
      !(source instanceof HTMLAnchorElement) ||
      typeof photographerName !== 'string' ||
      typeof photographerUrl !== 'string' ||
      typeof photoUrl !== 'string'
    )
      return;

    photographer.textContent = photographerName;
    photographer.href = photographerUrl;
    source.href = photoUrl;
    credit.hidden = false;
  })();
</script>
