---
import { localePath, toLanguageTag, type Locale } from '../i18n/config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticleHref } from '../lib/article-routes';
import { getVisibleArticles } from '../lib/articles';
import { formatDate } from '../lib/date';
import { getProjects } from '../lib/projects';
import * as m from '@sshawn9/site-i18n/messages';
import ProjectListItem from './ProjectListItem.astro';

type Props = { locale: Locale };
const { locale } = Astro.props;
const projects = await getProjects(locale);
const featuredProjects = projects.slice(0, 2);
const latestArticles = (await getVisibleArticles(locale)).slice(0, 4);
const projectsHref = localePath(locale, '/projects/');
const blogHref = localePath(locale, '/blog/');
const projectTagsLabel = m.project_tags({}, { locale });
---

<BaseLayout {locale}>
  <section class="content-shell flex min-h-[56vh] items-center py-16 sm:py-20">
    <div class="max-w-5xl" data-reveal>
      <h1
        class="text-[clamp(3rem,7vw,5.75rem)] leading-[0.98] font-extrabold tracking-[-0.065em] text-balance"
      >
        {m.home_hero_title({}, { locale })}
      </h1>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="button-primary" href={projectsHref}>
          {m.home_view_projects({}, { locale })}
        </a>
        <a class="button-secondary" href={blogHref}>
          {m.home_read_blog({}, { locale })}
        </a>
      </div>
    </div>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="content-shell pb-20 sm:pb-28" aria-labelledby="home-projects-heading">
        <div class="flex items-center justify-between gap-6" data-reveal>
          <h2
            id="home-projects-heading"
            class="text-3xl font-extrabold tracking-[-0.035em] sm:text-4xl"
          >
            {m.home_projects_title({}, { locale })}
          </h2>
          {projects.length > featuredProjects.length && (
            <a href={projectsHref} class="interactive-supporting text-sm font-bold">
              {m.home_all_projects({}, { locale })}
            </a>
          )}
        </div>
        <ol class="mt-8 grid gap-6">
          {featuredProjects.map((project, index) => (
            <li>
              <ProjectListItem
                {project}
                tagsLabel={projectTagsLabel}
                headingLevel="h3"
                showVisual
                reverse={index % 2 === 1}
              />
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    latestArticles.length > 0 && (
      <section class="border-y border-slate-900/8 bg-slate-900/[0.025] dark:border-white/8 dark:bg-white/[0.018]">
        <div class="content-shell py-20 sm:py-28">
          <div class="flex items-center justify-between gap-6" data-reveal>
            <h2 class="text-3xl font-extrabold tracking-[-0.035em] sm:text-4xl">
              {m.home_latest_articles({}, { locale })}
            </h2>
            <a href={blogHref} class="interactive-supporting text-sm font-bold">
              {m.home_all_articles({}, { locale })}
            </a>
          </div>

          <ol class="mt-8 divide-y divide-slate-900/10 dark:divide-white/10">
            {latestArticles.map((article) => {
              const entry = article.current.entry;
              const publishedAt = article.versions[0].entry.data.publishedAt;
              const contentLanguage = toLanguageTag(article.current.contentLocale);

              return (
                <li data-reveal>
                  <article class="group grid gap-3 py-7 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-8">
                    <div class="min-w-0" lang={contentLanguage}>
                      <h3 class="text-xl font-extrabold tracking-tight sm:text-2xl">
                        <a href={getArticleHref(article)} class="interactive-heading">
                          {entry.data.title}
                        </a>
                      </h3>
                      {entry.data.description && (
                        <p class="text-default mt-2 max-w-4xl text-sm leading-6">
                          {entry.data.description}
                        </p>
                      )}
                    </div>
                    <time
                      datetime={publishedAt.toISOString()}
                      class="text-supporting font-mono text-xs font-bold whitespace-nowrap sm:pt-1"
                    >
                      {formatDate(publishedAt, locale)}
                    </time>
                  </article>
                </li>
              );
            })}
          </ol>
        </div>
      </section>
    )
  }
</BaseLayout>
