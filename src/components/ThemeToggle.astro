---
import { Moon, Sun } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = { locale: Locale };
const { locale } = Astro.props;
---

<button
  type="button"
  class="icon-control relative"
  aria-label={m.theme_toggle({}, { locale })}
  title={m.theme_toggle({}, { locale })}
  data-theme-toggle
  data-label-light={m.theme_to_light({}, { locale })}
  data-label-dark={m.theme_to_dark({}, { locale })}
>
  <Sun class="size-[1.05rem] dark:hidden" aria-hidden="true" />
  <Moon class="hidden size-[1.05rem] dark:block" aria-hidden="true" />
</button>
