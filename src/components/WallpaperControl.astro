---
import { Image, RefreshCw } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = { locale: Locale; id: string };
const { locale, id } = Astro.props;
---

<div data-wallpaper-control>
  <button
    type="button"
    popovertarget={id}
    class="icon-control"
    aria-label={m.wallpaper_controls({}, { locale })}
    title={m.wallpaper_controls({}, { locale })}
    data-wallpaper-menu-trigger
  >
    <Image class="size-[1.05rem]" aria-hidden="true" />
  </button>

  <div
    {id}
    popover
    class="wallpaper-control__popover surface-strong m-0 max-h-[calc(100dvh-2rem)] w-[15.5rem] max-w-[calc(100vw-2rem)] overflow-y-auto rounded-xl p-2 shadow-lg"
    data-wallpaper-menu
  >
    <label
      class="flex cursor-pointer items-center justify-between gap-3 rounded-lg px-2 py-1.5"
      data-wallpaper-enabled-control
    >
      <span class="text-sm font-medium text-slate-700 dark:text-slate-200"
        >{m.wallpaper_use_random({}, { locale })}</span
      >
      <input type="checkbox" class="peer sr-only" data-wallpaper-enabled checked />
      <span
        class="wallpaper-switch__track relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-cyan-500 peer-focus-visible:ring-2 peer-focus-visible:ring-cyan-500 peer-focus-visible:ring-offset-2 peer-focus-visible:outline-none dark:bg-slate-600 dark:peer-checked:bg-cyan-400 dark:peer-focus-visible:ring-offset-slate-950"
        aria-hidden="true"
      >
        <span
          class="wallpaper-switch__thumb absolute top-0.5 left-0.5 size-4 rounded-full bg-white shadow-sm transition-transform"
        ></span>
      </span>
    </label>

    <div class="mt-1 flex items-center gap-1.5 px-1 pb-1">
      <fieldset
        class="min-w-0 flex-1 transition-opacity disabled:opacity-40"
        data-wallpaper-rotation
      >
        <legend class="sr-only">{m.wallpaper_rotation_mode({}, { locale })}</legend>
        <div class="grid grid-cols-2 rounded-lg bg-slate-900/6 p-0.5 dark:bg-white/6">
          <label class="min-w-0 cursor-pointer" data-wallpaper-mode-option="auto">
            <input
              type="radio"
              name={`wallpaper-rotation-${id}`}
              value="auto"
              class="peer sr-only"
              data-wallpaper-mode="auto"
              checked
            />
            <span
              class="block truncate rounded-md px-2 py-1.5 text-center text-xs font-semibold text-slate-600 transition-colors peer-checked:bg-white/90 peer-checked:text-cyan-700 peer-focus-visible:ring-2 peer-focus-visible:ring-cyan-500 dark:text-slate-300 dark:peer-checked:bg-white/10 dark:peer-checked:text-cyan-300"
              >{m.wallpaper_mode_auto({}, { locale })}</span
            >
          </label>
          <label class="min-w-0 cursor-pointer" data-wallpaper-mode-option="fixed">
            <input
              type="radio"
              name={`wallpaper-rotation-${id}`}
              value="fixed"
              class="peer sr-only"
              data-wallpaper-mode="fixed"
            />
            <span
              class="block truncate rounded-md px-2 py-1.5 text-center text-xs font-semibold text-slate-600 transition-colors peer-checked:bg-white/90 peer-checked:text-cyan-700 peer-focus-visible:ring-2 peer-focus-visible:ring-cyan-500 dark:text-slate-300 dark:peer-checked:bg-white/10 dark:peer-checked:text-cyan-300"
              >{m.wallpaper_mode_fixed({}, { locale })}</span
            >
          </label>
        </div>
      </fieldset>

      <button
        type="button"
        class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-slate-900/6 text-slate-600 transition-colors hover:bg-slate-900/10 hover:text-cyan-700 disabled:opacity-40 dark:bg-white/6 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-cyan-300"
        aria-label={m.wallpaper_next({}, { locale })}
        data-wallpaper-next
        disabled
      >
        <RefreshCw class="size-3.5" aria-hidden="true" data-wallpaper-next-icon />
      </button>
    </div>
  </div>
</div>

<style>
  [data-wallpaper-enabled]:checked + .wallpaper-switch__track .wallpaper-switch__thumb {
    transform: translateX(1rem);
  }

  [data-wallpaper-next][data-loading] {
    opacity: 1;
  }

  .wallpaper-control__popover {
    position: fixed;
    inset: auto;
    top: var(--wallpaper-menu-top, 5rem);
    left: var(--wallpaper-menu-left, 1rem);
  }
</style>
