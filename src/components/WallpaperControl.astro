---
import { Download, Image, RefreshCw } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import * as m from '../paraglide/messages.js';

type Props = { locale: Locale; id: string };
const { locale, id } = Astro.props;
---

<div data-wallpaper-control>
  <button
    type="button"
    popovertarget={id}
    class="icon-control"
    aria-label={m.wallpaper_controls({}, { locale })}
    title={m.wallpaper_controls({}, { locale })}
    data-wallpaper-menu-trigger
  >
    <Image class="size-[1.05rem]" aria-hidden="true" />
  </button>

  <div
    {id}
    popover
    class="wallpaper-control__popover m-0 max-h-[calc(100dvh-2rem)] w-[15.5rem] max-w-[calc(100vw-2rem)] overflow-y-auto rounded-xl p-2"
    data-wallpaper-menu
  >
    <label
      class="flex cursor-pointer items-center justify-between gap-3 rounded-lg px-2 py-1.5"
      data-wallpaper-enabled-control
    >
      <span class="text-default text-sm font-medium">{m.wallpaper_use_random({}, { locale })}</span>
      <input type="checkbox" class="peer sr-only" data-wallpaper-enabled checked />
      <span
        class="wallpaper-switch__track relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-cyan-500 peer-focus-visible:ring-2 peer-focus-visible:ring-cyan-500 peer-focus-visible:ring-offset-2 peer-focus-visible:outline-none dark:bg-slate-600 dark:peer-checked:bg-cyan-400 dark:peer-focus-visible:ring-offset-slate-950"
        aria-hidden="true"
      >
        <span
          class="wallpaper-switch__thumb absolute top-0.5 left-0.5 size-4 rounded-full bg-white shadow-sm transition-transform"
        ></span>
      </span>
    </label>

    <label
      class="mt-1 flex cursor-pointer items-center justify-between gap-3 rounded-lg px-2 py-1.5"
      data-wallpaper-auto-rotation-control
    >
      <span class="text-default text-sm font-medium"
        >{m.wallpaper_auto_rotation({}, { locale })}</span
      >
      <input type="checkbox" class="peer sr-only" data-wallpaper-auto-rotation checked />
      <span
        class="wallpaper-switch__track relative h-5 w-9 shrink-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-cyan-500 peer-focus-visible:ring-2 peer-focus-visible:ring-cyan-500 peer-focus-visible:ring-offset-2 peer-focus-visible:outline-none dark:bg-slate-600 dark:peer-checked:bg-cyan-400 dark:peer-focus-visible:ring-offset-slate-950"
        aria-hidden="true"
      >
        <span
          class="wallpaper-switch__thumb absolute top-0.5 left-0.5 size-4 rounded-full bg-white shadow-sm transition-transform"
        ></span>
      </span>
    </label>

    <div class="mt-1 grid grid-cols-2 gap-1.5 px-1 pb-1">
      <button
        type="button"
        class="interactive-supporting flex h-8 min-w-0 items-center justify-center gap-1.5 rounded-lg bg-slate-900/6 px-2 text-xs font-semibold hover:bg-slate-900/10 disabled:opacity-40 dark:bg-white/6 dark:hover:bg-white/10"
        data-wallpaper-refresh
        disabled
      >
        <RefreshCw class="size-3.5" aria-hidden="true" data-wallpaper-refresh-icon />
        <span>{m.wallpaper_refresh({}, { locale })}</span>
      </button>
      <button
        type="button"
        class="interactive-supporting flex h-8 min-w-0 items-center justify-center gap-1.5 rounded-lg bg-slate-900/6 px-2 text-xs font-semibold hover:bg-slate-900/10 disabled:opacity-40 dark:bg-white/6 dark:hover:bg-white/10"
        data-wallpaper-download
        disabled
      >
        <Download class="size-3.5" aria-hidden="true" />
        <span>{m.wallpaper_download({}, { locale })}</span>
      </button>
    </div>
  </div>
</div>

<style>
  [data-wallpaper-enabled]:checked + .wallpaper-switch__track .wallpaper-switch__thumb,
  [data-wallpaper-auto-rotation]:checked + .wallpaper-switch__track .wallpaper-switch__thumb {
    transform: translateX(1rem);
  }

  [data-wallpaper-refresh][data-loading] {
    opacity: 1;
  }

  [data-wallpaper-auto-rotation-control] {
    transition: opacity 150ms ease;
  }

  [data-wallpaper-auto-rotation-control]:has([data-wallpaper-auto-rotation]:disabled) {
    cursor: default;
    opacity: 0.4;
  }

  .wallpaper-control__popover {
    --wallpaper-menu-surface: rgb(255 255 255 / 0.58);
    position: fixed;
    inset: auto;
    top: var(--wallpaper-menu-top, 5rem);
    left: var(--wallpaper-menu-left, 1rem);
    border: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
    background: var(--wallpaper-menu-surface);
    box-shadow:
      inset 0 1px rgb(255 255 255 / 0.12),
      0 18px 48px rgb(7 10 18 / 0.2);
    backdrop-filter: blur(20px) saturate(1.08);
  }

  :global(.dark) .wallpaper-control__popover {
    --wallpaper-menu-surface: rgb(14 20 34 / 0.62);
  }
</style>
