{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sshawn9-com",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": false,
  "preview_urls": true,
  "secrets": {
    "required": ["UNSPLASH_ACCESS_KEY"],
  },
  "kv_namespaces": [
    {
      "binding": "WALLPAPER_MANIFEST",
    },
  ],
  "triggers": {
    "crons": ["0 */3 * * *"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/wallpapers", "/api/wallpapers/download"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "env": {
    "preview": {
      "name": "sshawn9-com-preview",
      "workers_dev": true,
      "preview_urls": true,
      "secrets": {
        "required": ["UNSPLASH_ACCESS_KEY"],
      },
      "kv_namespaces": [
        {
          "binding": "WALLPAPER_MANIFEST",
        },
      ],
      "triggers": {
        "crons": [],
      },
    },
  },
}
