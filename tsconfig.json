{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "apps/site/.astro/types.d.ts",
    "apps/site/src/env.d.ts",
    "worker/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["tests/.results"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  }
}
