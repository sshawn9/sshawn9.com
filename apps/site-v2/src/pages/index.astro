---
import { createLocaleEntryRedirectScript } from '../runtime/locale-preference';
import { SITE_CONTEXT } from '../config/site-context';

const localeRedirectScript = createLocaleEntryRedirectScript();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {SITE_CONTEXT.noIndex && <meta name="robots" content="noindex, follow" />}
    <title>SHAWN v2 foundation</title>
    <script is:inline set:html={localeRedirectScript} />
  </head>
  <body>
    <main>
      <h1>SHAWN</h1>
      <nav aria-label="Language">
        <a href="/en/">English</a>
        <a href="/zh/" lang="zh-CN">中文</a>
      </nav>
    </main>
  </body>
</html>
