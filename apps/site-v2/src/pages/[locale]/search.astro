---
import { LOCALES, type Locale } from '@sshawn9/site-domain/locales';
import SearchClient from '../../features/search/components/SearchClient.astro';
import SearchFallback from '../../features/search/components/SearchFallback.astro';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_FONT_QUERIES } from '../../runtime/required-fonts';

type Props = { locale: Locale };

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale }, props: { locale } }));
}

const { locale } = Astro.props;
const copy = getFoundationCopy(locale);
const hasGeneratedIndex = import.meta.env.PROD;
---

<BaseLayout
  title={copy.searchPageTitle}
  description={copy.searchPageDescription}
  {locale}
  noIndex
  fontQueries={[SITE_FONT_QUERIES.monoRegular]}
>
  {
    hasGeneratedIndex && (
      <link slot="head" rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    )
  }
  <section class="content-shell search-page" aria-labelledby="search-page-heading">
    <h1 id="search-page-heading" class="sr-only">{copy.searchPageTitle}</h1>
    {
      hasGeneratedIndex ? (
        <SearchClient {locale} />
      ) : (
        <div class="site-search-panel">
          <SearchFallback {locale} />
          <p class="site-search-dev-note">
            {copy.searchDevTitle} {copy.searchDevDescription}
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
