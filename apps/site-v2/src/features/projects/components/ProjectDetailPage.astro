---
import type { Locale } from '@sshawn9/site-domain/locales';
import type { SiteArticle } from '../../../content/article-catalog';
import { getArticleHref } from '../../../content/article-routes';
import type { SiteProject } from '../../../content/project-catalog';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_FONT_QUERIES } from '../../../runtime/required-fonts';

interface Props {
  locale: Locale;
  project: SiteProject;
  relatedArticles: SiteArticle[];
}

const { locale, project, relatedArticles } = Astro.props;
const copy = getFoundationCopy(locale);
const contentLanguageTag = project.contentLocale === 'zh' ? 'zh-CN' : 'en';
---

<BaseLayout
  title={project.title}
  description={project.description}
  {locale}
  searchable
  searchResultType="project"
  fontQueries={[SITE_FONT_QUERIES.monoRegular]}
>
  <section class="content-shell project-detail-page" lang={contentLanguageTag}>
    <nav aria-label={copy.breadcrumbs}>
      <ol class="breadcrumbs">
        <li><a href={`/${locale}/projects/`}>{copy.navProjects}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{project.title}</li>
      </ol>
    </nav>

    <header class="project-detail-header">
      <h1>{project.title}</h1>
      <p>{project.description}</p>
      {
        project.tags.length > 0 && (
          <ul class="project-tag-list" aria-label={copy.projectTags}>
            {project.tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      project.hasBody && (
        <article class="article-prose project-prose">
          <slot />
        </article>
      )
    }

    {
      relatedArticles.length > 0 && (
        <section class="project-related" aria-labelledby="project-related-heading">
          <h2 id="project-related-heading">{copy.projectRelatedArticles}</h2>
          <ol>
            {relatedArticles.map((article) => {
              const version = article.current;
              const articleLanguageTag = version.contentLocale === 'zh' ? 'zh-CN' : 'en';
              return (
                <li>
                  <article lang={articleLanguageTag}>
                    <h3>
                      <a href={getArticleHref(article)}>{version.entry.data.title}</a>
                    </h3>
                    {version.entry.data.description && <p>{version.entry.data.description}</p>}
                  </article>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }
  </section>
</BaseLayout>
