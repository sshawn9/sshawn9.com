---
import type { Locale } from '@sshawn9/site-domain/locales';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getFoundationCopy(locale);
---

<div class="wallpaper" data-wallpaper data-backdrop-surface>
  <div class="wallpaper__stage" aria-hidden="true">
    <div class="wallpaper__images">
      <div class="wallpaper__image" data-wallpaper-slot="a"></div>
      <div class="wallpaper__image" data-wallpaper-slot="b"></div>
    </div>
    <div class="wallpaper__scrim"></div>
  </div>

  <div class="wallpaper__credit" data-wallpaper-credit hidden>
    <span data-shell-sync-key="wallpaper-photo-by" data-shell-copy-text
      >{copy.wallpaperPhotoBy}</span
    >
    {' '}
    <a
      href="https://unsplash.com"
      target="_blank"
      rel="noreferrer"
      data-wallpaper-credit-photographer></a>{' '}
    <span data-shell-sync-key="wallpaper-on" data-shell-copy-text>{copy.wallpaperOn}</span>{' '}
    <a href="https://unsplash.com" target="_blank" rel="noreferrer" data-wallpaper-credit-photo
      >Unsplash</a
    >
  </div>
</div>
