---
import type { Locale } from '@sshawn9/site-domain/locales';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getFoundationCopy(locale);
---

<section class="content-shell about-page" aria-labelledby="about-heading">
  <div>
    <h1 id="about-heading" class="visually-hidden">{copy.aboutPageTitle}</h1>
    <p>{copy.aboutUnderConstruction}</p>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
