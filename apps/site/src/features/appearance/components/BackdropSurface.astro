---
import type { Locale } from '@sshawn9/site-domain/locales';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getFoundationCopy(locale);
---

<div class="wallpaper" data-wallpaper data-backdrop-surface>
  <div
    class="wallpaper__stage"
    aria-hidden="true"
    data-wallpaper-visual
    transition:persist="wallpaper-visual"
    transition:animate="none"
  >
    <div class="wallpaper__images">
      <div class="wallpaper__image" data-wallpaper-initial></div>
    </div>
    <div class="wallpaper__scrim"></div>
  </div>

  <div class="wallpaper__credit" data-wallpaper-credit data-font-surface hidden>
    <span>{copy.wallpaperPhotoBy}</span>
    {' '}
    <a
      href="https://unsplash.com"
      target="_blank"
      rel="noreferrer"
      data-wallpaper-credit-photographer></a>{' '}
    <span>{copy.wallpaperOn}</span>{' '}
    <a href="https://unsplash.com" target="_blank" rel="noreferrer" data-wallpaper-credit-photo
      >Unsplash</a
    >
  </div>
</div>
