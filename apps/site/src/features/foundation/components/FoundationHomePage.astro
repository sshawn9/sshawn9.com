---
import type { Locale } from '@sshawn9/site-domain/locales';
import type { SiteArticle } from '../../../content/article-catalog';
import type { SiteProject } from '../../../content/project-catalog';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';
import ProjectCard from '../../projects/components/ProjectCard.astro';
import '../action-links.css';
import '../home.css';
import '../responsive.css';

interface Props {
  locale: Locale;
  articles: SiteArticle[];
  projects: SiteProject[];
}

const { locale, articles, projects } = Astro.props;
const copy = getFoundationCopy(locale);
const featuredProjects = projects.slice(0, 2);
const dateFormatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<section class="content-shell home-hero" aria-labelledby="home-heading">
  <div class="home-hero__content">
    <h1 id="home-heading">{copy.homeHeroTitle}</h1>
    <div class="home-actions">
      <a class="button-primary" href={`/${locale}/projects/`}>{copy.homeViewProjects}</a>
      <a class="button-secondary" href={`/${locale}/blog/`}>{copy.homeReadBlog}</a>
    </div>
  </div>
</section>

{
  featuredProjects.length > 0 && (
    <section class="content-shell home-projects" aria-labelledby="home-projects-heading">
      <div class="section-heading">
        <h2 id="home-projects-heading">{copy.homeProjectsTitle}</h2>
        {projects.length > featuredProjects.length && (
          <a href={`/${locale}/projects/`}>{copy.homeAllProjects}</a>
        )}
      </div>
      <ol class="project-list">
        {featuredProjects.map((project, index) => (
          <li>
            <ProjectCard
              {project}
              tagsLabel={copy.projectTags}
              headingLevel="h3"
              showPreview
              reverse={index % 2 === 1}
            />
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  articles.length > 0 && (
    <section class="home-articles" aria-labelledby="recent-articles-heading">
      <div class="content-shell">
        <div class="section-heading">
          <h2 id="recent-articles-heading">{copy.homeLatestArticles}</h2>
          <a href={`/${locale}/blog/`}>{copy.homeAllArticles}</a>
        </div>
        <ol class="foundation-article-list">
          {articles.map((article) => {
            const version = article.current;
            const publishedAt = article.versions[0].entry.data.publishedAt;
            return (
              <li>
                <article
                  class="foundation-article-card"
                  lang={version.contentLocale === 'zh' ? 'zh-CN' : 'en'}
                >
                  <div>
                    <h3>
                      <a href={`/${locale}/blog/${article.id}/`}>{version.entry.data.title}</a>
                    </h3>
                    {version.entry.data.description && <p>{version.entry.data.description}</p>}
                  </div>
                  <time datetime={publishedAt.toISOString()}>
                    {dateFormatter.format(publishedAt)}
                  </time>
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </section>
  )
}
