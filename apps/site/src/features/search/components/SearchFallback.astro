---
import type { Locale } from '@sshawn9/site-domain/locales';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getFoundationCopy(locale);
---

<div class="site-search-fallback" role="status">
  <input
    class="site-search-fallback__input"
    type="search"
    placeholder={copy.searchPlaceholder}
    aria-label={copy.searchPageTitle}
    disabled
  />
  <p class="site-search-fallback__title">{copy.searchUnavailableTitle}</p>
  <p class="site-search-fallback__description">{copy.searchUnavailableDescription}</p>
  <nav class="site-search-fallback__links" aria-label={copy.primaryNavigation}>
    <a href={`/${locale}/`}>{copy.home}</a>
    <a href={`/${locale}/projects/`}>{copy.navProjects}</a>
    <a href={`/${locale}/blog/`}>{copy.navBlog}</a>
  </nav>
</div>
