---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '@sshawn9/site-domain/locales';
import SiteFooter from '../components/SiteFooter.astro';
import SiteRuntime from '../components/SiteRuntime.astro';
import SiteShell from '../components/SiteShell.astro';
import { getFoundationCopy } from '@sshawn9/site-i18n/copy';
import { BUILD_ID_META_NAME } from '../runtime/build-generation';
import { CURRENT_BUILD_ID } from '../runtime/build-identity';
import { INITIAL_FRAME_READY_ID } from '../runtime/initial-frame';
import { REQUIRED_FONT_META_NAME, SITE_FONT_QUERIES } from '../runtime/required-fonts';
import { SITE_CONTEXT } from '../config/site-context';
import initialDocumentScript from 'virtual:site-initial-document-script';
import wallpaperSystemUrl from 'virtual:site-wallpaper-script-url';
import typographyStylesUrl from '../styles/typography-vendor.css?url';
import '../styles/index.css';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  commitSha?: string;
  fontQueries?: readonly string[];
  canonical?: string;
  noIndex?: boolean;
  searchable?: boolean;
  searchResultType?: 'page' | 'article' | 'project';
  searchPublishedAt?: Date;
  alternateLinks?: ReadonlyArray<{ locale: Locale; href: string }>;
}

const {
  title,
  description,
  locale,
  commitSha,
  fontQueries = [],
  canonical,
  noIndex = false,
  searchable = false,
  searchResultType = 'page',
  searchPublishedAt,
  alternateLinks = [],
} = Astro.props;
const languageTag = locale === 'zh' ? 'zh-CN' : 'en';
const copy = getFoundationCopy(locale);
const searchResultTypeLabel = {
  page: copy.searchResultTypePage,
  article: copy.searchResultTypeArticle,
  project: copy.searchResultTypeProject,
}[searchResultType];
const searchPublishedLabel = searchPublishedAt
  ? new Intl.DateTimeFormat(languageTag, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    }).format(searchPublishedAt)
  : undefined;
const documentTitle = title === 'SHAWN' ? title : `${title} · SHAWN`;
const declaredFontQueries = [
  SITE_FONT_QUERIES.bodyRegular,
  SITE_FONT_QUERIES.displayBold,
  ...fontQueries,
].filter((query, index, queries) => queries.indexOf(query) === index);
const documentNoIndex = noIndex || SITE_CONTEXT.noIndex;
---

<!doctype html>
<html lang={languageTag} data-font-state="loading" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f8fb" />
    <script is:inline src={wallpaperSystemUrl} data-wallpaper-system-entry></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href={`/site.${locale}.webmanifest`} />
    <meta name={BUILD_ID_META_NAME} content={CURRENT_BUILD_ID} />
    {declaredFontQueries.map((query) => <meta name={REQUIRED_FONT_META_NAME} content={query} />)}
    <Font cssVariable="--font-manrope" preload={[{ weight: '200 800', style: 'normal' }]} />
    <Font cssVariable="--font-source-sans-3" preload={[{ weight: '200 900', style: 'normal' }]} />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: '100 800', style: 'normal' }]} />
    {description && <meta name="description" content={description} />}
    {searchable && <meta data-pagefind-meta="title[content]" content={title} />}
    {
      searchable && description && (
        <meta data-pagefind-meta="description[content]" content={description} />
      )
    }
    {searchable && <meta data-pagefind-meta={`type:${searchResultTypeLabel}`} />}
    {
      searchable && searchPublishedAt && searchPublishedLabel && (
        <meta
          data-pagefind-meta={`published:${searchPublishedLabel}`}
          data-pagefind-sort={`published:${searchPublishedAt.toISOString()}`}
        />
      )
    }
    <slot name="head" />
    {canonical && <link rel="canonical" href={canonical} />}
    {documentNoIndex && <meta name="robots" content="noindex, follow" />}
    {
      alternateLinks.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale === 'zh' ? 'zh-CN' : 'en'}
          href={alternate.href}
        />
      ))
    }
    <title>{documentTitle}</title>
    <link rel="stylesheet" href={typographyStylesUrl} />
    <link rel="expect" href={`#${INITIAL_FRAME_READY_ID}`} blocking="render" />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-font-surface>{copy.skipToContent}</a>
    <SiteShell {locale} />
    <div
      class="page-outlet"
      data-font-surface
      transition:name="page-outlet"
      transition:animate="none"
    >
      <main
        id="main-content"
        tabindex="-1"
        data-pagefind-body={searchable ? '' : undefined}
        data-pagefind-ignore={searchable ? undefined : 'all'}
      >
        <slot />
      </main>
      <SiteFooter {locale} {commitSha} />
    </div>
    <script is:inline set:html={initialDocumentScript} />
    <span id={INITIAL_FRAME_READY_ID} data-initial-frame-document-ready aria-hidden="true"></span>
    <SiteRuntime />
  </body>
</html>
