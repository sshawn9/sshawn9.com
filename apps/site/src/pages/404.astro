---
import { Font } from 'astro:assets';
import NavigationProgress from '../components/NavigationProgress.astro';
import * as m from '@sshawn9/site-i18n/messages';
import { INITIAL_FRAME_READY_ID } from '../runtime/initial-frame';
import { REQUIRED_FONT_META_NAME, SITE_FONT_QUERIES } from '../runtime/required-fonts';
import fallbackLocaleScript from 'virtual:site-fallback-locale-script';
import initialDocumentScript from 'virtual:site-initial-document-script';
import typographyStylesUrl from '../styles/typography-vendor.css?url';
import '../features/foundation/action-links.css';
import '../styles/index.css';

const copy = {
  en: {
    title: `${m.not_found_title({}, { locale: 'en' })} · SHAWN`,
    heading: m.not_found_heading({}, { locale: 'en' }),
    text: m.not_found_text({}, { locale: 'en' }),
    homeLabel: m.home({}, { locale: 'en' }),
    home: m.not_found_home({}, { locale: 'en' }),
    search: m.not_found_search({}, { locale: 'en' }),
  },
  zh: {
    title: `${m.not_found_title({}, { locale: 'zh' })} · SHAWN`,
    heading: m.not_found_heading({}, { locale: 'zh' }),
    text: m.not_found_text({}, { locale: 'zh' }),
    homeLabel: m.home({}, { locale: 'zh' }),
    home: m.not_found_home({}, { locale: 'zh' }),
    search: m.not_found_search({}, { locale: 'zh' }),
  },
} as const;
const localeTitles = JSON.stringify({
  en: copy.en.title,
  zh: copy.zh.title,
});
---

<!doctype html>
<html lang="en" data-locale="en" data-font-state="loading" data-wallpaper-mode="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#f7f8fb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name={REQUIRED_FONT_META_NAME} content={SITE_FONT_QUERIES.bodyRegular} />
    <meta name={REQUIRED_FONT_META_NAME} content={SITE_FONT_QUERIES.displayBold} />
    <meta name={REQUIRED_FONT_META_NAME} content={SITE_FONT_QUERIES.monoRegular} />
    <Font cssVariable="--font-manrope" preload={[{ weight: '200 800', style: 'normal' }]} />
    <Font cssVariable="--font-source-sans-3" preload={[{ weight: '200 900', style: 'normal' }]} />
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: '100 800', style: 'normal' }]} />
    <title>{copy.en.title}</title>
    <script is:inline>
      (() => {
        let storedTheme;
        try {
          storedTheme = localStorage.getItem('theme');
        } catch {}
        const dark =
          storedTheme === 'dark' ||
          (storedTheme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#070a12' : '#f7f8fb');
      })();
    </script>
    <script is:inline data-locale-titles={localeTitles} set:html={fallbackLocaleScript} />
    <link rel="stylesheet" href={typographyStylesUrl} />
    <link rel="expect" href={`#${INITIAL_FRAME_READY_ID}`} blocking="render" />
  </head>
  <body>
    <header class="site-header">
      <NavigationProgress />
      <div class="content-shell site-header__inner" data-font-surface>
        {
          (['en', 'zh'] as const).map((locale) => (
            <span class="fallback-locale-copy" data-fallback-locale={locale}>
              <a
                class="site-identity"
                href={`/${locale}/`}
                aria-label={`${copy[locale].homeLabel} · Shawn`}
              >
                <span class="site-identity__monogram" aria-hidden="true">
                  S
                </span>
                <span>SHAWN</span>
              </a>
            </span>
          ))
        }
      </div>
    </header>

    <main class="not-found-page" data-font-surface aria-busy="true">
      {
        (['en', 'zh'] as const).map((locale) => (
          <div class="fallback-locale-copy" data-fallback-locale={locale}>
            <div class="not-found-page__content" lang={locale === 'zh' ? 'zh-CN' : 'en'}>
              <p class="not-found-page__eyebrow">ERROR / 404</p>
              <h1>{copy[locale].heading}</h1>
              <p class="not-found-page__description">{copy[locale].text}</p>
              <div class="not-found-page__actions">
                <a class="button-primary" href={`/${locale}/`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m15 18-6-6 6-6M9 12h11" />
                  </svg>
                  {copy[locale].home}
                </a>
                <a class="button-secondary" href={`/${locale}/search/`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-4.35-4.35" />
                  </svg>
                  {copy[locale].search}
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </main>

    <footer class="site-footer" data-font-surface>
      <div class="content-shell">
        {
          (['en', 'zh'] as const).map((locale) => (
            <span class="fallback-locale-copy" data-fallback-locale={locale}>
              <a href={`/${locale}/`}>SHAWN</a>
            </span>
          ))
        }
      </div>
    </footer>

    <script is:inline set:html={initialDocumentScript} />
    <span id={INITIAL_FRAME_READY_ID} data-initial-frame-document-ready aria-hidden="true"></span>
  </body>
</html>

<style is:global>
  .fallback-locale-copy {
    display: none;
  }

  html[data-locale='en'] .fallback-locale-copy[data-fallback-locale='en'],
  html[data-locale='zh'] .fallback-locale-copy[data-fallback-locale='zh'] {
    display: contents;
  }

  .not-found-page {
    min-height: calc(100vh - var(--header-height) - var(--site-footer-block-size));
    display: grid;
    place-items: center;
    padding: 5rem 1rem;
    text-align: center;
  }

  .not-found-page__content {
    width: min(100%, 40rem);
  }

  .not-found-page__eyebrow {
    color: var(--text-accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .not-found-page h1 {
    margin-top: 1.5rem;
    font-size: clamp(3.75rem, 12vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    text-wrap: balance;
  }

  .not-found-page__description {
    max-width: 36rem;
    margin: 1.5rem auto 0;
    font-size: 1rem;
    line-height: 1.75rem;
  }

  .not-found-page__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .not-found-page__actions svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
</style>
