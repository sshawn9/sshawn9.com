---
import type { FoundationCopy } from '@sshawn9/site-i18n/copy';

interface Props {
  copy: FoundationCopy;
  inline?: boolean;
}

const { copy, inline = false } = Astro.props;
---

<div
  id={inline ? undefined : 'wallpaper-settings'}
  class={inline ? 'site-header__mobile-wallpaper' : 'wallpaper-settings'}
  popover={inline ? undefined : 'auto'}
  role={inline ? 'group' : 'dialog'}
  aria-label={copy.wallpaperControls}
  data-transient-overlay={inline ? undefined : ''}
>
  <label class="wallpaper-settings__row" data-wallpaper-enabled-control>
    <span>{copy.wallpaperUseRandom}</span>
    <input class="sr-only" type="checkbox" data-wallpaper-enabled checked />
    <span class="wallpaper-switch" aria-hidden="true"><span></span></span>
  </label>

  <label class="wallpaper-settings__row" data-wallpaper-auto-rotation-control>
    <span>{copy.wallpaperAutoRotation}</span>
    <input class="sr-only" type="checkbox" data-wallpaper-auto-rotation checked />
    <span class="wallpaper-switch" aria-hidden="true"><span></span></span>
  </label>

  <div class="wallpaper-settings__actions">
    <button type="button" data-wallpaper-next disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 11a8.1 8.1 0 0 0-15.5-2M4 4v5h5M4 13a8.1 8.1 0 0 0 15.5 2M20 20v-5h-5"></path>
      </svg>
      <span>{copy.wallpaperNext}</span>
    </button>
    <button type="button" data-wallpaper-download disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path>
      </svg>
      <span>{copy.wallpaperDownload}</span>
    </button>
  </div>
</div>
