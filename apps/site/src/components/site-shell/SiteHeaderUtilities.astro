---
import { SITE } from '@sshawn9/site-domain/site';
import type { Locale } from '@sshawn9/site-domain/locales';
import type { FoundationCopy } from '@sshawn9/site-i18n/copy';

interface Props {
  locale: Locale;
  targetLocale: Locale;
  otherLocaleHref: string;
  copy: FoundationCopy;
  mobile?: boolean;
}

const { locale, targetLocale, otherLocaleHref, copy, mobile = false } = Astro.props;
const searchIsCurrent = Astro.url.pathname.startsWith(`/${locale}/search/`);
---

<div class={mobile ? 'site-header__mobile-utilities' : 'site-header__utilities'}>
  {
    !mobile && (
      <a
        class="site-header__icon-control site-header__search"
        href={`/${locale}/search/`}
        aria-label={copy.navSearch}
        title={copy.navSearch}
        aria-current={searchIsCurrent ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-4.35-4.35" />
        </svg>
      </a>
    )
  }

  <a
    class="site-header__icon-control"
    data-locale-switch={targetLocale}
    href={otherLocaleHref}
    hreflang={targetLocale}
    lang={targetLocale === 'zh' ? 'zh-CN' : 'en'}
    aria-label={copy.switchLanguage}
    title={copy.switchLanguage}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1m14 20-5-10-5 10m2-4h6"></path>
    </svg>
  </a>

  <div class="site-header__appearance" data-appearance-controls>
    <button
      type="button"
      class="site-header__icon-control site-header__theme"
      data-theme-toggle
      data-theme-to-light-label={copy.themeToLight}
      data-theme-to-dark-label={copy.themeToDark}
      aria-label={copy.themeToggle}
      title={copy.themeToggle}
      aria-pressed="false"
    >
      <svg class="site-header__theme-light" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
        ></path>
      </svg>
      <svg class="site-header__theme-dark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
      </svg>
    </button>

    {
      !mobile && (
        <button
          type="button"
          class="site-header__icon-control"
          aria-label={copy.wallpaperControls}
          title={copy.wallpaperControls}
          popovertarget="wallpaper-settings"
          data-wallpaper-menu-trigger
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
          </svg>
        </button>
      )
    }
  </div>

  <a
    class="site-header__icon-control site-header__github"
    href={SITE.github}
    target="_blank"
    rel="noreferrer"
    aria-label={copy.githubProfile}
    title="GitHub"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M12 .297a12 12 0 0 0-3.795 23.385c.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57A12 12 0 0 0 12 .297Z"
      ></path>
    </svg>
  </a>
</div>
